@@ -0,0 +1,116 @@
+from __future__ import annotations
+import functools
+from typing import TYPE_CHECKING,NamedTuple,Optional,Tuple
+import torch
+import torch.nn.functional as F
+from sglang.kernels.jit.utils import cache_once,load_jit
+from sglang.kernels.ops.speculative.dflash_head_gemm import aligned_bf16_operands,cublas_split_k,tuned_linear
+if TYPE_CHECKING:
+  from tvm_ffi.module import Module
+MAX_SPLITS=8
+SPLIT_BLOCK_K=64
+STAGE_K=256
+STAGES={
+    (1 ,1 ):6 ,(2 ,1 ):4 ,(4 ,1 ):3 ,
+    (1 ,2 ):6 ,(2 ,2 ):4 ,(4 ,2 ):2 ,
+}
+TOKEN_FRAGS=(1 ,2 )
+MAX_TOKENS=16
+LT_MAX_TOKENS=256
+TARGET_CTAS_PER_SM=1.4
+WGMMA_MAX_TOKENS=32
+WGMMA_CONFIG=(4 ,128 ,8 )
+WGMMA_MIN_SPLITS=4
+WGMMA_MIN_CTAS_PER_SM=0.5
+class SkinnyGemmConfig(NamedTuple):
+  warps:int
+  token_frags:int
+  block_k:int
+  stages:int
+  splits:int
+@cache_once
+def _module()->Module:
+  return load_jit(
+      "dflash_skinny_gemm",cuda_files=[ "speculative/dflash_skinny_gemm.cuh"],
+      cuda_wrappers=[( "gemm", "dflash_skinny_gemm"),( "gemm_conv_prepare", "dflash_skinny_gemm_conv_prepare")],
+      extra_cuda_cflags=[ "-O3"],
+  )
+@functools.lru_cache(maxsize=None)
+def _is_sm90(device_index:int)->bool:
+  return torch.version.hip is None and torch.cuda.get_device_capability(device_index)==(9 ,0 )
+@functools.lru_cache(maxsize=None)
+def _num_sms(device_index:int)->int:
+  return torch.cuda.get_device_properties(device_index).multi_processor_count
+def skinny_gemm_config(x:torch.Tensor,w:torch.Tensor)->Optional[SkinnyGemmConfig]:
+  if not(
+      aligned_bf16_operands(x,w)
+      and _is_sm90(x.device.index)
+      and x.shape[0 ]<=WGMMA_MAX_TOKENS
+      and x.is_contiguous()
+      and w.is_contiguous()
+  ):
+    return None
+  m,k=x.shape
+  n=w.shape[0 ]
+  blocks=k//SPLIT_BLOCK_K
+  device=x.device.index
+  splits=cublas_split_k(m,n,k,device)
+  num_sms=_num_sms(device)
+  if(
+      k%SPLIT_BLOCK_K or not 1 <=splits<=min(MAX_SPLITS,blocks)or(splits-1 )*-(-blocks//splits)>=blocks
+  ):
+    return None
+  if m>MAX_TOKENS:
+    if n%64 or splits<WGMMA_MIN_SPLITS or n//64 *splits<WGMMA_MIN_CTAS_PER_SM*num_sms:
+      return None
+    return SkinnyGemmConfig(4 ,*WGMMA_CONFIG,splits)
+  token_frags=next(f for f in TOKEN_FRAGS if 8 *f>=m)
+  fitting=[r for r in(4 ,2 ,1 )if n%(16 *r)==0 ]
+  if not fitting:
+    return None
+  warps=next((r for r in fitting if n//(16 *r)*splits>=TARGET_CTAS_PER_SM*num_sms),fitting[-1 ])
+  return SkinnyGemmConfig(warps,token_frags,STAGE_K,STAGES[(warps,token_frags)],splits)
+def dflash_linear(
+    x:torch.Tensor,weight:torch.Tensor,tuned:bool=True,programmatic:bool=False
+)->torch.Tensor:
+  x2=x.reshape(-1 ,x.shape[-1 ])
+  config=skinny_gemm_config(x2,weight)
+  if config is not None:
+    y=x2.new_empty((x2.shape[0 ],weight.shape[0 ]))
+    _module().gemm(x2,weight,y,*config,programmatic and x2.shape[0 ]<=MAX_TOKENS)
+    return y.view(*x.shape[:-1 ],weight.shape[0 ])
+  if tuned and MAX_TOKENS<x2.shape[0 ]<=LT_MAX_TOKENS:
+    y=tuned_linear(x2,weight)
+    if y is not None:
+      return y.view(*x.shape[:-1 ],weight.shape[0 ])
+  return F.linear(x,weight)
+MAX_CONV_TAPS=4
+def dflash_conv_prepare(
+    x:torch.Tensor,weight:torch.Tensor,base:torch.Tensor,block_size:int,programmatic=False
+)->Optional[Tuple[torch.Tensor,torch.Tensor]]:
+  config=skinny_gemm_config(x,weight)if x.dim()==2 and x.shape[0 ]<=MAX_TOKENS else None
+  if config is None or base.dim()!=2 or base.dtype!=torch.bfloat16:
+    return None
+  taps,k=base.shape
+  n=weight.shape[0 ]
+  groups=n//(2 *taps)
+  groups_per_tile=16 *config.warps//taps
+  if(
+      not 2 <=taps<=MAX_CONV_TAPS
+      or k!=x.shape[1 ]
+      or n%(2 *taps)
+      or 16 *config.warps%taps
+      or base.stride(1 )!=1
+      or base.stride(0 )%8
+      or base.data_ptr()%16
+      or k%groups
+      or(k//groups)%8
+      or groups_per_tile%4
+      or groups%groups_per_tile
+      or(groups_per_tile*(k//groups))%SPLIT_BLOCK_K
+  ):
+    return None
+  coefficients=x.new_empty((x.shape[0 ],n))
+  conv=torch.empty_like(x)
+  _module().gemm_conv_prepare(x,weight,coefficients,base,conv,block_size,*config,programmatic)
+  return conv,coefficients

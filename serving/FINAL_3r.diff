+    qk_norm_rope8<ROPE>(x, s_cos, s_sin, d0);
+    *reinterpret_cast<uint2*>(kc + lrow * 128 + (tid >> 3) * 64 + d0) = qk_pack8(x);
+  } else if (tid < 32) {

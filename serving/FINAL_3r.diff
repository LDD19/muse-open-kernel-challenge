+inline void hopper_moe_gather_plan_rb(TensorView p, TensorView gw, TensorView lid, TensorView pos, TensorView counts,
+    TensorView xt, TensorView rrow, TensorView offsets, TensorView tiles, TensorView ntiles, TensorView rows,

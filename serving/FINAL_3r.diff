+  vec=8
+  num_vec_blocks=hidden_size//(vec*threads)
+  if(
+      cluster_n!=1
+      or threads!=num_threads
+      or threads<32
+      or hidden_size!=num_vec_blocks*vec*threads
+      or num_vec_blocks&(num_vec_blocks-1 )
+  ):
+    return None
+  return threads,vec,num_vec_blocks
+def conv_finish_add_rmsnorm(
+    x:torch.Tensor,delta:torch.Tensor,base:torch.Tensor,residual:torch.Tensor,weight:torch.Tensor,eps:float,
+    block_size:int,group_size:int,layout,
+)->torch.Tensor:
+  T,H=x.shape
+  taps=base.shape[0 ]
+  threads,vec,num_vec_blocks=layout
+  out=torch.empty_like(x)
+  if T==0 :
+    return out
+  _conv_finish_add_rmsnorm_kernel[(T,)](
+      x,delta,base,residual,weight,out,x.stride(0 ),delta.stride(0 ),delta.stride(1 ),residual.stride(0 ),
+      out.stride(0 ),eps,BLOCK_SIZE=block_size,H=H,TAPS=taps,GROUP_SIZE=group_size,THREADS=threads,
+      LOG2_THREADS=threads.bit_length()-1 ,VEC=vec,NUM_VEC_BLOCKS=num_vec_blocks,num_warps=threads//32 ,
+  )
+  return out

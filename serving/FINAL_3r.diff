+inline void moe_fused_impl(TensorView w13, TensorView w2, TensorView xt, TensorView inter, TensorView y,
+    TensorView tiles, TensorView ntiles, TensorView gs13, TensorView gs2, int64_t nctas, int64_t smem,
+    TensorView counter, TensorView done, int64_t fine, const long long* rd) {
+  using namespace muse_hopper_moe;
+  CHECK_HOST(fine >= 0 && fine <= 2 && nctas > 0 && (fine || !rd)) << "hopper_moe_fused args";
+  FusedArgs fa{};
+  fa.flags = static_cast<int>(fine) << 8;
+  fa.g1 = Args{ptr<const uint8_t>(w13), ptr<const uint8_t>(xt), ptr<const int4>(tiles), ptr<const int>(ntiles),
+      ptr<const float>(gs13), ptr<uint8_t>(inter), 64, ptr<int>(counter), 64u, 16u};
+  fa.g2 = Args{ptr<const uint8_t>(w2), ptr<const uint8_t>(inter), ptr<const int4>(tiles), ptr<const int>(ntiles),
+      ptr<const float>(gs2), ptr<uint8_t>(y), 32, ptr<int>(counter), 64u, 16u};
+  fa.done = ptr<int>(done);
+  fa.rdst = rd;
+  auto* k = rd ? (fine == 2 ? moe_fused_persistent<2, true> : moe_fused_persistent<1, true>)
+      : (fine == 2 ? moe_fused_persistent<2> : (fine ? moe_fused_persistent<1> : moe_fused_persistent<0>));
+  launch_pdl(k, dim3(static_cast<unsigned>(nctas)), dim3(MOE_FUSED_THREADS), static_cast<size_t>(smem), stream_of(xt), fa);

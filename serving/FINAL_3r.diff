+import mmap
+import os
+import platform
+import socket
+import time
+import numpy as np
+import torch
+import torch.distributed as dist
+_CH={}
+CAP=8 <<20
+L=16
+def chan(g):
+  if g not in _CH:
+    _CH[g]=_Chan.make(g)
+  return _CH[g]
+def all_reduce(t,op,g):
+  c=chan(g)
+  if not(c and c.all_reduce(t,op)):
+    dist.all_reduce(t,op=op,group=g)
+def broadcast(t,src,group):
+  c=chan(group)if group is not None and t.device.type== "cpu"and t.is_contiguous()else None
+  if not(c and src==c.src and c.broadcast(t)):
+    dist.broadcast(t,src=src,group=group)
+class _Chan:
+  @staticmethod
+  def make(g):
+    n,r=dist.get_world_size(g),dist.get_rank(g)
+    if n<2 or os.environ.get( "SGLANG_HOST_SHM_COLL", "1")!= "1"or platform.machine()!= "x86_64":
+      return None
+    src=dist.get_global_rank(g,0 )
+    o = [f"/dev/shm/sgl_hc_{os.getpid()}_{id(g)}"]
+    dist.broadcast_object_list(o,src=src,group=g)
+    h=[None]*n
+    dist.all_gather_object(h,socket.gethostname(),group=g)
+    sz,one,ok=(n+1 )*L*8 +2 *n*512 +CAP,len(set(h))==1 ,torch.tensor([0 ])
+    try:
+      if one and r==0 :
+        with open(o[0 ], "wb")as f:
+          f.truncate(sz)
+    except OSError:
+      pass
+    dist.barrier(g)
+    try:
+      if one:
+        with open(o[0 ], "r+b")as f:
+          m=mmap.mmap(f.fileno(),sz)
+        ok[0 ]=1
+    except(OSError,ValueError):
+      pass
+    dist.all_reduce(ok,op=dist.ReduceOp.MIN,group=g)
+    if r==0 and os.path.exists(o[0 ]):
+      os.unlink(o[0 ])
+    return _Chan(n,r,src,m)if ok[0 ]else None
+  def __init__(self,n,r,src,m):
+    self.r,self.src,self.m,self.k,self.b=r,src,m,0 ,0
+    self.c=np.frombuffer(m,np.int64,(n+1 )*L)
+    self.d=np.frombuffer(m,np.int64,2 *n*64 ,(n+1 )*L*8 ).reshape(2 ,n,64 )
+    self.buf=np.frombuffer(m,np.uint8,CAP,(n+1 )*L*8 +2 *n*512 )
+    self.seq,self.ack,self.h=self.c[0 :n*L:L],self.c[1 :n*L:L],n*L
+  def _wait(self,f):
+    i,t=0 ,time.monotonic()+1800
+    while not f():
+      i+=1
+      if i>64 :
+        os.sched_yield()
+        if not i&4095 and time.monotonic()>t:
+          raise RuntimeError( "host shm collective timed out")
+  def all_reduce(self,t,op):
+    if(t.dtype not in(torch.int32,torch.int64)or t.numel()>64 or not t.is_contiguous()
+            or op not in(dist.ReduceOp.MIN,dist.ReduceOp.MAX)):
+      return False
+    v=t.view(-1 )
+    self.k=k=self.k+1
+    d=self.d[k&1 ]
+    d[self.r,:v.numel()]=v.numpy()
+    self.seq[self.r]=k
+    self._wait(lambda:self.seq.min()>=k)
+    f=np.minimum if op==dist.ReduceOp.MIN else np.maximum
+    v.copy_(torch.from_numpy(f.reduce(d[:,:v.numel()],axis=0 )))
+    return True
+  def broadcast(self,t):
+    nb=t.numel()*t.element_size()
+    if nb>CAP:
+      return False
+    self.b=k=self.b+1
+    c,h,v=self.c,self.h,t.view(-1 ).view(torch.uint8).numpy()
+    if self.r==0 :
+      self._wait(lambda:self.ack[1 :].min()>=k-1 )
+      self.buf[:nb]=v
+      c[h]=k
+      return True
+    self._wait(lambda:c[h]>=k)
+    v[:]=self.buf[:nb]
+    self.ack[self.r]=k
+    return True

+#pragma once
+
+#include <sgl_kernel/tensor.h>
+
+#if defined(__USE_FAST_MATH__)
+#error "qk_norm_rope_store_verify.cuh must be compiled without --use_fast_math (non-FTZ fp32 arithmetic)"
+#endif
+
+namespace sglang {
+using tvm::ffi::TensorView;
+namespace qk_norm_rope_store_verify_impl {
+inline constexpr int kWarpThreads = 32;
+inline constexpr int kColsPerLane = 2;
+inline constexpr int kHeadDim = kWarpThreads * kColsPerLane;
+inline constexpr int kMaxWarps = 32;
+
+struct Params {
+  const bf16_t* qkv;
+  uint8_t* q_out;
+  bf16_t* k_out;
+  const int64_t* positions;
+  const float* cos_sin;
+  uint8_t* k_cache;
+  uint8_t* v_cache;
+  const int64_t* cache_loc;
+  float eps;
+  int64_t stride_qkv;
+  int n_rows;
+  int num_q_heads;
+  int num_kv_heads;
+};
+
+SGL_DEVICE float triton_fdiv(float a, float b) {
+  float r;
+  asm("div.full.f32 %0, %1, %2;" : "=f"(r) : "f"(a), "f"(b));
+  return r;
+}
+
+SGL_DEVICE float triton_rsqrt(float x) {
+  float r;
+  asm("rsqrt.approx.ftz.f32 %0, %1;" : "=f"(r) : "f"(x));
+  return r;
+}
+
+SGL_DEVICE float bf16_round(float x) {
+  return __bfloat162float(__float2bfloat16_rn(x));
+}
+
+template <bool kSaturate, bool kNanKeepsSign>
+SGL_DEVICE uint32_t fp8e4m3fn_bits(float x) {
+  uint32_t f_bits = __float_as_uint(x);
+  const uint32_t sign = (f_bits >> 31) << 7;
+  f_bits &= 0x7FFFFFFFu;
+  const bool overflow = f_bits >= (1087u << 20);
+  const bool is_nan = f_bits > 0x7F800000u;
+  constexpr uint32_t kDenormMask = 141u << 23;
+  const float denorm_sum = __fadd_rn(__uint_as_float(f_bits), __uint_as_float(kDenormMask));
+  const uint32_t denorm = (__float_as_uint(denorm_sum) - kDenormMask) & 0xFFu;
+  const uint32_t mant_odd = (f_bits >> 20) & 1u;
+  uint32_t normal = ((f_bits - (120u << 23) + 0x7FFFFu + mant_odd) >> 20) & 0xFFu;
+  uint32_t big = 0x7Fu;
+  if constexpr (kSaturate) {
+    normal = normal == 0x7Fu ? 0x7Eu : normal;
+    big = is_nan ? 0x7Fu : 0x7Eu;
+  }
+  uint32_t result = f_bits < (121u << 23) ? denorm : normal;
+  result = (overflow ? big : result) | sign;
+  if constexpr (!kNanKeepsSign) {
+    result = is_nan ? 0x7Fu : result;
+  }
+  return result;
+}
+
+template <bool kSaturate, bool kNanKeepsSign>
+SGL_DEVICE uint16_t fp8_pair(float lo, float hi) {
+  return static_cast<uint16_t>(fp8e4m3fn_bits<kSaturate, kNanKeepsSign>(lo) |
+      (fp8e4m3fn_bits<kSaturate, kNanKeepsSign>(hi) << 8));
+}
+
+template <bool kHasRope, bool kSaturate, bool kNanKeepsSign, bool kUsePDL>
+__global__ void __launch_bounds__(kMaxWarps* kWarpThreads) qk_norm_rope_store_verify_kernel(const Params p) {
+  if constexpr (kUsePDL) {
+    asm volatile("griddepcontrol.wait;" ::: "memory");
+    asm volatile("griddepcontrol.launch_dependents;" :::);
+  }
+  const int lane = threadIdx.x % kWarpThreads;
+  const int row = static_cast<int>(blockIdx.x * (blockDim.x / kWarpThreads) + threadIdx.x / kWarpThreads);
+  if (row >= p.n_rows) return;
+  const int heads = p.num_q_heads + 2 * p.num_kv_heads;
+  const int64_t token = row / heads;
+  const int head = row % heads;
+  const int col = kColsPerLane * lane;
+
+  const bf16x2_t raw =
+      *reinterpret_cast<const bf16x2_t*>(p.qkv + token * p.stride_qkv + static_cast<int64_t>(head) * kHeadDim + col);
+  const float x0 = __low2float(raw);
+  const float x1 = __high2float(raw);
+
+  const bool is_q = head < p.num_q_heads;
+  const bool is_v = head >= p.num_q_heads + p.num_kv_heads;
+  const int64_t loc = is_q ? 0 : p.cache_loc[token];
+  const int kv_head = is_v ? head - p.num_q_heads - p.num_kv_heads : head - p.num_q_heads;
+  const int64_t kv_dst = loc * (static_cast<int64_t>(p.num_kv_heads) * kHeadDim) + kv_head * kHeadDim + col;
+
+  if (is_v) {
+    if (loc != 0) *reinterpret_cast<uint16_t*>(p.v_cache + kv_dst) = fp8_pair<kSaturate, kNanKeepsSign>(x0, x1);
+    return;
+  }
+
+  float s = __fmaf_rn(x0, x0, __fmul_rn(x1, x1));
+  for (int offset = kWarpThreads / 2; offset > 0; offset /= 2) {
+    s = __fadd_rn(s, __shfl_xor_sync(0xFFFFFFFFu, s, offset));
+  }
+  const float rstd = triton_rsqrt(__fadd_rn(p.eps, triton_fdiv(s, static_cast<float>(kHeadDim))));
+  float y0 = bf16_round(__fmul_rn(rstd, x0));
+  float y1 = bf16_round(__fmul_rn(rstd, x1));
+  if constexpr (kHasRope) {
+    const float* cs = p.cos_sin + p.positions[token] * kHeadDim;
+    const float cos_v = cs[lane];
+    const float sin_v = cs[kHeadDim / 2 + lane];
+    const float even = __fmaf_rn(y0, cos_v, -__fmul_rn(y1, sin_v));
+    const float odd = __fmaf_rn(y1, cos_v, __fmul_rn(y0, sin_v));
+    y0 = bf16_round(even);
+    y1 = bf16_round(odd);
+  }
+  const uint16_t y8 = fp8_pair<kSaturate, kNanKeepsSign>(y0, y1);
+  if (is_q) {
+    *reinterpret_cast<uint16_t*>(p.q_out + (token * p.num_q_heads + head) * kHeadDim + col) = y8;
+  } else {
+    *reinterpret_cast<bf16x2_t*>(p.k_out + (token * p.num_kv_heads + kv_head) * kHeadDim + col) =
+        __floats2bfloat162_rn(y0, y1);
+    if (loc != 0) *reinterpret_cast<uint16_t*>(p.k_cache + kv_dst) = y8;
+  }
+}
+
+}
+
+template <bool kHasRope, bool kSaturate, bool kNanKeepsSign, bool kUsePDL>
+void qk_norm_rope_store_verify(
+    TensorView qkv, TensorView q_out, TensorView k_out, TensorView positions, TensorView cos_sin, TensorView k_cache,
+    TensorView v_cache, TensorView cache_loc, double eps, int64_t num_q_heads, int64_t num_kv_heads, int64_t num_sms) {
+  using namespace host;
+  using namespace qk_norm_rope_store_verify_impl;
+  auto T = SymbolicSize{"num_tokens"};
+  auto W = SymbolicSize{"qkv_width"};
+  auto S = SymbolicSize{"qkv_row_stride"};
+  auto N = SymbolicSize{"cache_rows"};
+  auto QW = SymbolicSize{"q_width"};
+  auto KW = SymbolicSize{"kv_width"};
+  auto device_ = SymbolicDevice{};
+  device_.set_options<kDLCUDA>();
+  TensorMatcher({T, W}).with_strides({S, 1}).with_dtype<bf16_t>().with_device(device_).verify(qkv);
+  TensorMatcher({T, QW}).with_dtype<uint8_t>().with_device(device_).verify(q_out);
+  TensorMatcher({T, KW}).with_dtype<bf16_t>().with_device(device_).verify(k_out);
+  TensorMatcher({N, KW}).with_dtype<uint8_t>().with_device(device_).verify(k_cache);
+  TensorMatcher({N, KW}).with_dtype<uint8_t>().with_device(device_).verify(v_cache);
+  TensorMatcher({T}).with_dtype<int64_t>().with_device(device_).verify(cache_loc);
+  if constexpr (kHasRope) {
+    auto P = SymbolicSize{"max_positions"};
+    TensorMatcher({T}).with_dtype<int64_t>().with_device(device_).verify(positions);
+    TensorMatcher({P, kHeadDim}).with_dtype<fp32_t>().with_device(device_).verify(cos_sin);
+  }
+  const int64_t tokens = T.unwrap();
+  RuntimeCheck(QW.unwrap() == num_q_heads * kHeadDim && KW.unwrap() == num_kv_heads * kHeadDim,
+               "qk_norm_rope_store_verify: head_dim must be ", kHeadDim);
+  RuntimeCheck(W.unwrap() >= (num_q_heads + 2 * num_kv_heads) * kHeadDim, "qk_norm_rope_store_verify: qkv too narrow");
+  RuntimeCheck(qkv.stride(0) % 2 == 0 && reinterpret_cast<uintptr_t>(qkv.data_ptr()) % 4 == 0,
+               "qk_norm_rope_store_verify: qkv rows must be 4-byte aligned");
+  if (tokens == 0) return;
+
+  const int64_t n_rows = tokens * (num_q_heads + 2 * num_kv_heads);
+  RuntimeCheck(n_rows < (int64_t{1} << 31), "qk_norm_rope_store_verify: too many rows");
+  const int64_t warps = std::clamp<int64_t>((n_rows + num_sms - 1) / num_sms, 1, kMaxWarps);
+  const int64_t ctas = (n_rows + warps - 1) / warps;
+
+  const DLDevice device = device_.unwrap();
+  int smem_per_sm = 0;
+  RuntimeCheck(
+      cudaDeviceGetAttribute(&smem_per_sm, cudaDevAttrMaxSharedMemoryPerMultiprocessor, device.device_id) ==
+          cudaSuccess,
+      "qk_norm_rope_store_verify: shared memory attribute");
+  const int spread_smem = smem_per_sm / 2;
+  const auto kernel = qk_norm_rope_store_verify_kernel<kHasRope, kSaturate, kNanKeepsSign, kUsePDL>;
+  RuntimeCheck(
+      cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, spread_smem) == cudaSuccess,
+      "qk_norm_rope_store_verify: dynamic shared memory attribute");
+
+  Params p;
+  p.qkv = static_cast<const bf16_t*>(qkv.data_ptr());
+  p.q_out = static_cast<uint8_t*>(q_out.data_ptr());
+  p.k_out = static_cast<bf16_t*>(k_out.data_ptr());
+  p.positions = kHasRope ? static_cast<const int64_t*>(positions.data_ptr()) : nullptr;
+  p.cos_sin = kHasRope ? static_cast<const float*>(cos_sin.data_ptr()) : nullptr;
+  p.k_cache = static_cast<uint8_t*>(k_cache.data_ptr());
+  p.v_cache = static_cast<uint8_t*>(v_cache.data_ptr());
+  p.cache_loc = static_cast<const int64_t*>(cache_loc.data_ptr());
+  p.eps = static_cast<float>(eps);
+  p.stride_qkv = qkv.stride(0);
+  p.n_rows = static_cast<int>(n_rows);
+  p.num_q_heads = static_cast<int>(num_q_heads);
+  p.num_kv_heads = static_cast<int>(num_kv_heads);
+  LaunchKernel(dim3(static_cast<unsigned>(ctas)), dim3(static_cast<unsigned>(warps * kWarpThreads)), device,
+      spread_smem)
+      .enable_pdl(kUsePDL)(kernel, p);
+}
+
+}

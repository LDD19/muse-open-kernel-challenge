+++ b/python/sglang/kernels/ops/speculative/dflash_head_gemm.py
@@ -0,0 +1,143 @@
+from __future__ import annotations
+import functools
+from typing import TYPE_CHECKING,Dict,List,Optional,Tuple
+import torch
+from sglang.kernels.jit.utils import cache_once,load_jit
+if TYPE_CHECKING:
+  from tvm_ffi.module import Module
+OPERAND_ALIGNMENT=256
+CUBLAS_WORKSPACE_BYTES=32 <<20
+HEAD_QUERY_STEPS=(16 ,32 )
+MIN_SPEEDUP=1.03
+TIMING_ROUNDS=3
+CALLS_PER_ROUND=5
+COLD_L2_MULTIPLE=2
+ALGO_WORDS=9
+MAX_ALGOS=16
+_choices:Dict[Tuple[int,...],Optional[torch.Tensor]]={}
+@cache_once
+def _module()->Module:
+  return load_jit(
+      "dflash_head_gemm",cuda_files=[ "speculative/dflash_head_gemm.cuh"],
+      cuda_wrappers=[
+          ( "gemm", "dflash_head_gemm"),( "algos", "dflash_head_gemm_algos"),
+          ( "cublas_split_k", "dflash_cublas_split_k"),
+      ],
+      extra_cuda_cflags=[ "-O3"],extra_ldflags=[ "-lcublasLt"],
+  )
+@functools.lru_cache(maxsize=None)
+def cublas_split_k(m:int,n:int,k:int,device_index:int)->int:
+  with torch.cuda.device(device_index):
+    return _module().cublas_split_k(m,n,k,CUBLAS_WORKSPACE_BYTES)
+def offered_algos(
+    x:torch.Tensor,w:torch.Tensor,y:torch.Tensor,query_m:int,max_workspace:int=0
+)->torch.Tensor:
+  buf=torch.empty((MAX_ALGOS,ALGO_WORDS),dtype=torch.int64)
+  return buf[:_module().algos(x,w,y,query_m,max_workspace,buf)]
+def aligned_bf16_operands(x:torch.Tensor,w:torch.Tensor)->bool:
+  return(
+      x.dim()==2
+      and w.dim()==2
+      and x.dtype==torch.bfloat16
+      and w.dtype==torch.bfloat16
+      and x.is_cuda
+      and torch.version.hip is None
+      and x.shape[0 ]>0
+      and x.shape[1 ]==w.shape[1 ]
+      and x.stride(1 )==1
+      and w.stride(1 )==1
+      and x.data_ptr()%OPERAND_ALIGNMENT==0
+      and w.data_ptr()%OPERAND_ALIGNMENT==0
+  )
+_timing_streams:Dict[int,torch.cuda.Stream]={}
+def _timing_stream(device:torch.device)->torch.cuda.Stream:
+  index=device.index if device.index is not None else torch.cuda.current_device()
+  stream=_timing_streams.get(index)
+  if stream is None:
+    from cuda.bindings import runtime as cudart
+    with torch.cuda.device(index):
+      err,handle=cudart.cudaStreamCreateWithFlags(cudart.cudaStreamNonBlocking)
+    if err!=cudart.cudaError_t.cudaSuccess:
+      raise RuntimeError(f"cudaStreamCreateWithFlags failed: {err}")
+    stream=_timing_streams[index]=torch.cuda.ExternalStream(int(handle),device=index)
+  return stream
+def _cold_times_us(runs,weights:List[torch.Tensor])->List[List[float]]:
+  stream,graphs=_timing_stream(weights[0 ].device),[]
+  stream.wait_stream(torch.cuda.current_stream())
+  with torch.cuda.stream(stream):
+    for run in runs:
+      run(weights[0 ])
+      graph=torch.cuda.CUDAGraph()
+      graph.capture_begin()
+      try:
+        for w in weights:
+          run(w)
+      finally:
+        graph.capture_end()
+      graphs.append(graph)
+  torch.cuda.current_stream().wait_stream(stream)
+  times=[[]for _ in graphs]
+  for _ in range(TIMING_ROUNDS*CALLS_PER_ROUND):
+    for graph,t in zip(graphs,times):
+      start,end=torch.cuda.Event(enable_timing=True),torch.cuda.Event(enable_timing=True)
+      start.record()
+      graph.replay()
+      end.record()
+      end.synchronize()
+      t.append(start.elapsed_time(end)*1000.0 /len(weights))
+  return times
+def _choose(
+    x:torch.Tensor,w:torch.Tensor,max_workspace:int,query_steps:Tuple[int,...]
+)->Optional[torch.Tensor]:
+  y=x.new_empty((x.shape[0 ],w.shape[0 ]))
+  m=x.shape[0 ]
+  first=offered_algos(x,w,y,m,max_workspace)
+  if first.shape[0 ]==0 :
+    return None
+  candidates=list(first)
+  for step in query_steps:
+    if m>step:
+      candidates+=list(offered_algos(x,w,y,m-step,max_workspace))
+  l2=torch.cuda.get_device_properties(x.device).L2_cache_size
+  copies=-(-COLD_L2_MULTIPLE*l2//(w.shape[0 ]*w.stride(0 )*w.element_size()))
+  weights=[w]+[torch.zeros_like(w)for _ in range(copies-1 )]
+  workspaces=[torch.empty(int(a[-1 ]),dtype=torch.uint8,device=x.device)for a in candidates]
+  times=_cold_times_us(
+      [lambda v,a=a,ws=ws:_module().gemm(x,v,y,a,ws)for a,ws in zip(candidates,workspaces)],weights
+  )
+  def speedup(i:int,quantile:float)->float:
+    ratios=sorted(t0/t for t0,t in zip(times[0 ],times[i]))
+    return ratios[int(quantile*(len(ratios)-1 ))]
+  probe=torch.arange(x.numel(),device=x.device,dtype=torch.float32).mul_(0.6180339887 ).frac_().sub_(0.5 )
+  probe=torch.empty_strided(x.shape,x.stride(),dtype=x.dtype,device=x.device).copy_(probe.view(x.shape))
+  reference=torch.matmul(probe,w.T)
+  for i in range(1 ,len(candidates)):
+    if speedup(i,0.5 )<MIN_SPEEDUP:
+      continue
+    _module().gemm(probe,w,y,candidates[i],workspaces[i])
+    if torch.equal(y,reference):
+      return candidates[i]
+  return None
+def tuned_linear(
+    x:torch.Tensor,w:torch.Tensor,tune:bool=True,max_workspace:int=CUBLAS_WORKSPACE_BYTES,
+    query_steps:Tuple[int,...]=(),
+)->Optional[torch.Tensor]:
+  if not aligned_bf16_operands(x,w):
+    return None
+  key=(x.device.index,*x.shape,w.shape[0 ],x.stride(0 ),w.stride(0 ),max_workspace)
+  if key not in _choices:
+    if not tune or torch.cuda.is_current_stream_capturing():
+      return None
+    _choices[key]=_choose(x,w,max_workspace,query_steps)
+  choice=_choices[key]
+  if choice is None:
+    return None
+  y=x.new_empty((x.shape[0 ],w.shape[0 ]))
+  _module().gemm(x,w,y,choice,torch.empty(int(choice[-1 ]),dtype=torch.uint8,device=x.device))
+  return y
+def tune_linear(w:torch.Tensor,token_counts:List[int])->None:
+  for m in token_counts:
+    tuned_linear(w.new_zeros((m,w.shape[1 ])),w)
+def dflash_head_gemm(x:torch.Tensor,w:torch.Tensor)->torch.Tensor:
+  y=tuned_linear(x,w,max_workspace=0 ,query_steps=HEAD_QUERY_STEPS)
+  return torch.matmul(x,w.T)if y is None else y

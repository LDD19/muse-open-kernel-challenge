+from __future__ import annotations
+from typing import TYPE_CHECKING,Optional,Tuple
+import torch
+from sglang.kernels.jit.utils import cache_once,is_arch_support_pdl,load_jit,make_cpp_args
+from sglang.kernels.ops.moe.muse_spark_routing_jit import _NORMALIZATION_MODES,_experts_per_lane,_warps_per_block
+if TYPE_CHECKING:
+  from tvm_ffi.module import Module
+@cache_once
+def _verify_jit_module(topk:int,experts_per_lane:int,norm_mode:int,warps_per_block:int)->Module:
+  args=make_cpp_args(topk,experts_per_lane,norm_mode,warps_per_block,is_arch_support_pdl())
+  return load_jit(
+      "muse_spark_routing_split2_verify",*args,cuda_files=[ "muse_spark/routing_split2_verify.cuh"],
+      cuda_wrappers=[("fused_muse_spark_routing_split2", f"fused_muse_spark_routing_split2<{args}>")],
+  )
+def fused_muse_spark_routing_split2_verify(
+    op,split2_logits:torch.Tensor,topk:int
+)->Optional[Tuple[torch.Tensor,torch.Tensor,torch.Tensor]]:
+  if not(
+      split2_logits.is_cuda
+      and split2_logits.dim()==2
+      and split2_logits.dtype==torch.float32
+      and split2_logits.is_contiguous()
+      and split2_logits.shape[1 ]%8 ==0
+      and 1 <=topk<=32
+      and op.router_score_normalization in _NORMALIZATION_MODES
+  ):
+    return None
+  topk_ids=op.sol_topk_out
+  if topk_ids is not None and split2_logits.shape[0 ]>topk_ids.shape[0 ]:
+    topk_ids=None
+  num_tokens,num_split2=split2_logits.shape
+  num_experts=num_split2//2
+  bias_f32=op.expert_bias.float()
+  topk_weights=split2_logits.new_empty((num_tokens,topk),dtype=torch.float32)
+  if topk_ids is None:
+    topk_ids=split2_logits.new_empty((num_tokens,topk),dtype=torch.int32)
+  topk_ids_view=topk_ids[:num_tokens,:topk]
+  packed=split2_logits.new_empty((num_tokens,topk),dtype=torch.int32)
+  module=_verify_jit_module(
+      topk,_experts_per_lane(num_experts),_NORMALIZATION_MODES[op.router_score_normalization],
+      _warps_per_block(num_tokens),
+  )
+  module.fused_muse_spark_routing_split2(
+      split2_logits,bias_f32,topk_weights,topk_ids_view,packed,op.local_expert_mapping,op.num_valid_tokens,
+      float(op.router_output_multiplier if op.router_output_multiplier is not None else 1.0 ),float(op.route_scale),
+      float(op.router_score_division_eps if op.router_score_division_eps is not None else 0.0 ),
+  )
+  return topk_weights,topk_ids_view,packed

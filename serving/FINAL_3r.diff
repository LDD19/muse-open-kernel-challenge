index 0000000000..73a7fca57e
--- /dev/null
+++ b/python/sglang/kernels/ops/moe/muse_spark_hopper_moe.py
@@ -0,0 +1,254 @@
+"""Muse Spark NVFP4 routed experts on Hopper: one persistent grouped-GEMM launch (CUDA JIT, sm_90a).
+
+Kernels: ``kernels/jit/csrc/muse_spark/hopper_prefill_moe.cuh`` (based on team vjeux's
+Apache-2.0 ``muse_prefill_layer.py``, modified by team LDD19).
+"""
+from __future__ import annotations
+from typing import TYPE_CHECKING,Optional,Tuple
+import torch
+import triton
+import triton.language as tl
+from sglang.kernels.jit.utils import cache_once,load_jit
+if TYPE_CHECKING:
+  from tvm_ffi.module import Module
+HIDDEN = 8192
+D_EXPERT = 4096
+INTERMEDIATE = 4096
+TOP_K=8
+LOCAL_EXPERTS=32
+NUM_EXPERTS=256
+KS,WBLK=64 ,4608
+MOE_SMEM=227 *1024
+MOE_LARGE_T = 8192
+MOE_ORDER_BIGGEST_FIRST=1
+MOE_ORDER_EXPERTS_GROUPED=3
+MOE_FINE_ORDER_SHIFT=8
+MIN_TILE_ROWS=32
+MOE_TILE_SLACK=64
+MAX_PADDED_ROWS_PER_EXPERT=256
+FINE_MIN_T=512
+FINE96_MAX_T = 8192
+_WRAPPERS=(
+    "moe_route", "moe_ids_to_routes", "moe_gather_plan", "qk_prep", "boundary", "boundary_rc", "moe_init", "moe_fused",
+    "moe_gather_plan_rb", "moe_fused_rb",
+)
+@cache_once
+def hopper_moe_module(fast_scales:bool=True)->Module:
+  flags = ["--use_fast_math"] + ([] if fast_scales else ["-DMOE_FAST_SCALE=0"])
+  module=load_jit(
+      "muse_spark_hopper_moe", "fast_scale"if fast_scales else "exact_scale",
+      cuda_files=[ "muse_spark/hopper_prefill_moe.cuh"],
+      cuda_wrappers=[(name, f"hopper_{name}") for name in _WRAPPERS], extra_cuda_cflags=flags,
+  )
+  module.moe_init(MOE_SMEM)
+  return module
+def fast_scales_ok(*scales:torch.Tensor)->bool:
+  for s in scales:
+    u=s.view(torch.uint8)
+    if not bool(((u>=0x08 )&(u<=0x7E )).all()):
+      return False
+  return True
+
+# (nibble slot -> positions of (m0, m1, m2, sign)); layout adapted from ZhimaoL/sglang
+# okc_patch (Apache-2.0).
+_CODE_POS={
+    3 :(6 ,7 ,8 ,15 ),
+    7 :(22 ,23 ,24 ,31 ),
+    1 :(28 ,29 ,30 ,5 ),
+    5 :(12 ,13 ,14 ,21 ),
+    2 :(25 ,26 ,27 ,2 ),
+    6 :(9 ,10 ,11 ,18 ),
+    0 :(4 ,0 ,1 ,3 ),
+    4 :(20 ,16 ,17 ,19 ),
+}
+_SLOT_ORDER=(3 ,7 ,1 ,5 ,2 ,6 ,0 ,4 )
+@torch.no_grad()
+def repack_nvfp4_experts(w: torch.Tensor, sf: torch.Tensor, gated: bool) -> torch.Tensor:
+  E,N,half_k=w.shape
+  n_tiles=N//128
+  dev=w.device
+  if gated:
+    nt=torch.arange(n_tiles,device=dev).view(n_tiles,1 ,1 )
+    q=torch.arange(8 ,device=dev).view(1 ,8 ,1 )
+    lr=torch.arange(16 ,device=dev).view(1 ,1 ,16 )
+    perm=torch.where(lr<8 ,64 *nt+8 *q+lr,N//2 +64 *nt+8 *q+lr-8 ).reshape(-1 )
+  else:
+    perm=torch.arange(N,device=dev)
+  out=torch.empty((E,n_tiles,KS,WBLK),dtype=torch.uint8,device=dev)
+  sf_u8=sf.view(torch.uint8)
+  pos=torch.tensor([_CODE_POS[i]for i in _SLOT_ORDER],dtype=torch.int64,device=dev)
+  bits=torch.arange(4 ,device=dev)
+  chunk=8
+  for e in range(E):
+    for t0 in range(0 ,n_tiles,chunk):
+      t1=min(n_tiles,t0+chunk)
+      rows=perm.view(n_tiles,128 )[t0:t1].reshape(-1 )
+      packed=w[e][rows]
+      c=torch.stack((packed&15 ,packed>>4 ),dim=-1 ).flatten(-2 ).to(torch.int32)
+      c=c.view(t1-t0,2 ,4 ,2 ,8 ,KS,4 ,2 ,4 ,2 )
+      c=c.permute(0 ,5 ,1 ,2 ,4 ,8 ,6 ,3 ,7 ,9 ).reshape(t1-t0,KS,2 ,4 ,8 ,4 ,4 ,8 )
+      cb=(c.to(torch.int64).unsqueeze(-1 )>>bits)&1
+      words=(cb<<pos).sum((-1 ,-2 ))&0xFFFFFFFF
+      wbytes=torch.stack([(words>>(8 *i))&0xFF for i in range(4 )],dim=-1 ).to(torch.uint8)
+      out[e, t0:t1, :, :4096] = wbytes.reshape(t1 - t0, KS, 4096)
+      s=sf_u8[e][rows].view(t1-t0,2 ,4 ,2 ,8 ,KS,4 )
+      out[e, t0:t1, :, 4096:] = s.permute(0, 5, 1, 2, 4, 6, 3).reshape(t1 - t0, KS, 512)
+  return out
+def norm_weight_minus_one(effective:Optional[torch.Tensor],size:int,device)->torch.Tensor:
+  if effective is None:
+    return torch.zeros(size,dtype=torch.bfloat16,device=device)
+  w=(effective.float()-1.0 ).to(torch.bfloat16)
+  if not torch.equal(w.float()+1.0 ,effective.float()):
+    raise ValueError( "norm weight is not representable as 1 + bf16(w)")
+  return w.contiguous()
+@triton.jit
+def _combine_kernel(y_ptr, rrow_ptr, lid_ptr, w_ptr, pw_ptr, out_ptr, H: tl.constexpr):
+    offs = tl.arange(0, H)
+    t = tl.program_id(0)
+    pw = 1.0 + tl.load(pw_ptr + offs).to(tl.float32)
+    c = 0
+    r0 = 0
+    r1 = 0
+    w0 = 0.0
+    w1 = 0.0
+    for k in tl.static_range(8):
+        lid = tl.load(lid_ptr + t * 8 + k)
+        row = tl.load(rrow_ptr + t * 8 + k)
+        wk = tl.load(w_ptr + t * 8 + k)
+        isl = lid >= 0
+        r0 = tl.where(isl & (c == 0), row, r0)
+        w0 = tl.where(isl & (c == 0), wk, w0)
+        r1 = tl.where(isl & (c == 1), row, r1)
+        w1 = tl.where(isl & (c == 1), wk, w1)
+        c += isl.to(tl.int32)
+    m0 = (offs < H) & (c >= 1)
+    m1 = (offs < H) & (c >= 2)
+    ya = tl.load(y_ptr + r0.to(tl.int64) * H + offs, mask=m0, other=0.0).to(tl.float32) * pw
+    yb = tl.load(y_ptr + r1.to(tl.int64) * H + offs, mask=m1, other=0.0).to(tl.float32) * pw
+    ra = tl.rsqrt(tl.sum(ya * ya, 0) / H + 1e-8)
+    rb = tl.rsqrt(tl.sum(yb * yb, 0) / H + 1e-8)
+    acc = tl.zeros([H], dtype=tl.float32)
+    acc += (ya * ra) * w0
+    acc += (yb * rb) * w1
+    if c > 2:
+        n = 0
+        for k in tl.static_range(8):
+            lid = tl.load(lid_ptr + t * 8 + k)
+            n += (lid >= 0).to(tl.int32)
+            if (lid >= 0) & (n > 2):
+                row = tl.load(rrow_ptr + t * 8 + k)
+                yk = tl.load(y_ptr + row.to(tl.int64) * H + offs).to(tl.float32) * pw
+                rk = tl.rsqrt(tl.sum(yk * yk, 0) / H + 1e-8)
+                acc += (yk * rk) * tl.load(w_ptr + t * 8 + k)
+    tl.store(out_ptr + t.to(tl.int64) * H + offs, acc.to(tl.bfloat16))
+def counter_block_size(num_tokens:int)->int:
+  return LOCAL_EXPERTS+1 +max_tiles(num_tokens)
+def max_tiles(num_tokens:int)->int:
+  return num_tokens*TOP_K//MIN_TILE_ROWS+MOE_TILE_SLACK
+class MuseSparkHopperExperts:
+  def __init__(
+      self,w13:torch.Tensor,w13_scale:torch.Tensor,w13_global_scale:torch.Tensor,w2:torch.Tensor,
+      w2_scale:torch.Tensor,w2_global_scale:torch.Tensor,num_experts:int=NUM_EXPERTS,
+      decode_engine:bool=False,
+  ):
+    self.num_experts=num_experts
+    self.fast_scales=fast_scales_ok(w13_scale,w2_scale)
+    self.w13 = repack_nvfp4_experts(w13, w13_scale, gated=True)
+    self.w2 = repack_nvfp4_experts(w2, w2_scale, gated=False)
+    self.gs13=w13_global_scale.to(torch.bfloat16).float().reshape(LOCAL_EXPERTS).contiguous()
+    self.gs2=w2_global_scale.to(torch.bfloat16).float().reshape(LOCAL_EXPERTS).contiguous()
+    self.num_sms=torch.cuda.get_device_properties(w13.device).multi_processor_count
+    self._all_rows=w13.new_full((1 ,),1 <<30 ,dtype=torch.int32)
+    self.engine=None
+    if decode_engine and self.fast_scales:
+      from sglang.kernels.ops.moe.muse_spark_hopper_moe_engine import MuseSparkHopperMoEEngine
+      self.engine=MuseSparkHopperMoEEngine(self.w13,self.w2,self.gs13,self.gs2)
+  @property
+  def module(self)->Module:
+    return hopper_moe_module(self.fast_scales)
+  def experts_from_routes(
+      self,x:torch.Tensor,pre_norm_w:torch.Tensor,post_norm_w:torch.Tensor,lid:torch.Tensor,
+      pos:torch.Tensor,cnt:torch.Tensor,counters:torch.Tensor,topk_weights:torch.Tensor,
+  )->torch.Tensor:
+    T=x.shape[0 ]
+    mod=self.module
+    maxrows=T*TOP_K+LOCAL_EXPERTS*MAX_PADDED_ROWS_PER_EXPERT
+    ntiles_max=max_tiles(T)
+    offsets=x.new_empty((LOCAL_EXPERTS,),dtype=torch.int32)
+    rows=x.new_empty((LOCAL_EXPERTS,),dtype=torch.int32)
+    tiles=x.new_empty((ntiles_max,4 ),dtype=torch.int32)
+    ntiles=x.new_empty((1 ,),dtype=torch.int32)
+    order=MOE_ORDER_BIGGEST_FIRST if T>=MOE_LARGE_T else MOE_ORDER_EXPERTS_GROUPED
+    fine=0 if T<FINE_MIN_T else(2 if T<FINE96_MAX_T else 1 )
+    xt=x.new_empty((maxrows,D_EXPERT),dtype=torch.bfloat16)
+    rrow=x.new_empty((T,TOP_K),dtype=torch.int32)
+    mod.moe_gather_plan(
+        x,pre_norm_w,lid,pos,cnt,xt,rrow,offsets,tiles,ntiles,rows,order|(fine<<MOE_FINE_ORDER_SHIFT)
+    )
+    inter=x.new_empty((maxrows,INTERMEDIATE),dtype=torch.bfloat16)
+    y=x.new_empty((maxrows,D_EXPERT),dtype=torch.bfloat16)
+    mod.moe_fused(
+        self.w13,self.w2,xt,inter,y,tiles,ntiles,self.gs13,self.gs2,self.num_sms,MOE_SMEM,
+        counters[0 :1 ],counters[1 :1 +ntiles_max],fine,
+    )
+    out=x.new_empty((T,D_EXPERT),dtype=torch.bfloat16)
+    _combine_kernel[(T,)](y,rrow,lid,topk_weights,post_norm_w,out,H=D_EXPERT,num_warps=8 )
+    return out
+  def experts_rb(
+      self,x:torch.Tensor,pre_norm_w:torch.Tensor,lid:torch.Tensor,pos:torch.Tensor,cnt:torch.Tensor,
+      counters:torch.Tensor,ib:torch.Tensor,m:int,tmap:Optional[torch.Tensor]=None,fine:Optional[int]=None,
+      ctl:bool=False,
+  ):
+
+    T,mod=x.shape[0 ],self.module
+    order=MOE_ORDER_BIGGEST_FIRST if T>=MOE_LARGE_T or fine is not None else MOE_ORDER_EXPERTS_GROUPED
+    fine=(2 if T<FINE96_MAX_T else 1 )if fine is None else fine
+    maxrows,nt=T*TOP_K+LOCAL_EXPERTS*MAX_PADDED_ROWS_PER_EXPERT,max_tiles(T)
+    i32=torch.int32
+    offsets,rows,ntiles=(x.new_empty((n,),dtype=i32)for n in(LOCAL_EXPERTS,LOCAL_EXPERTS,1 ))
+    tiles=x.new_empty((nt,4 ),dtype=i32)
+    xt=x.new_empty((maxrows,D_EXPERT),dtype=torch.bfloat16)
+    rrow=x.new_empty((T,TOP_K),dtype=i32)
+    rdst=x.new_empty((maxrows,),dtype=torch.int64)
+    mod.moe_gather_plan_rb(
+        x,pre_norm_w,lid,pos,cnt,xt,rrow,offsets,tiles,ntiles,rows,
+        order|(fine<<MOE_FINE_ORDER_SHIFT),rdst,ib,rdst[:0 ].view(i32)if tmap is None else tmap,m,
+    )
+    inter=x.new_empty((maxrows,INTERMEDIATE),dtype=torch.bfloat16)
+    y=x.new_empty((maxrows,D_EXPERT),dtype=torch.bfloat16)if ctl else xt
+    (mod.moe_fused if ctl else mod.moe_fused_rb)(
+        self.w13,self.w2,xt,inter,y,tiles,ntiles,self.gs13,self.gs2,self.num_sms,MOE_SMEM,
+        counters[0 :1 ],counters[1 :1 +nt],fine,*(()if ctl else(rdst,)),
+    )
+    return(y,rdst,rrow)if ctl else rrow
+  def experts_from_ids(
+      self,x:torch.Tensor,topk_weights:torch.Tensor,topk_ids:torch.Tensor,local_start:torch.Tensor,
+      pre_norm_w:torch.Tensor,post_norm_w:torch.Tensor,engine_flags:Optional[torch.Tensor]=None,
+  )->torch.Tensor:

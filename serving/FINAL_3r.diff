index 0000000000..502d2b3480
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/muse_spark/hopper_moe_engine.cuh
@@ -0,0 +1,1155 @@
+// Based on the muse_moe_w4a16 board engine of team LDD19 (Open Kernel Challenge 2026), parts adapted from
+// Madhavan113/kerneloptimizer and keell0renz/muse-open-kernel-challenge (Apache License 2.0).
+#pragma once
+
+#include <sgl_kernel/tensor.h>
+
+#ifndef MOE_ENGINE_FT_T
+#define MOE_ENGINE_FT_T 64
+#endif
+
+namespace sglang {
+using tvm::ffi::TensorView;
+namespace muse_moe_engine {
+SGL_DEVICE int warp_index(int t) { return __shfl_sync(0xffffffffu, t >> 5, 0); }
+SGL_DEVICE float warp_sum(float v) {
+  for (int o = 16; o > 0; o >>= 1) v += __shfl_xor_sync(0xffffffffu, v, o);
+  return v;
+}
+constexpr uint64_t L2_EVICT_FIRST = 0x12F0000000000000ull, L2_EVICT_LAST = 0x14F0000000000000ull;
+constexpr int GATHER_BATCH = 8;
+constexpr int B_HOLD_STAGES = 1;
+
+constexpr int HD = 4096, ID = 4096;
+constexpr int NLOC = 32;
+constexpr int NW = 16, NT = NW * 32;
+constexpr int NTL = NT + 64;
+#define CTA_SYNC() asm volatile("bar.sync 1, %0;\n" ::"n"(NT) : "memory")
+#define WS_JOIN() asm volatile("bar.sync 2, %0;\n" ::"n"(NTL) : "memory")
+constexpr int SK_T = 8;
+constexpr int FT_T = MOE_ENGINE_FT_T;
+constexpr int MMAX = 384, EMAX = MMAX * 8, JMAX = 32 + EMAX / FT_T + 8;
+constexpr float TWO62 = 4.611686018427388e18f;
+constexpr float PRE_NORM_EPS = 1e-5f;
+SGL_DEVICE float marlin_out(float acc, float gsc) {
+  return __bfloat162float(__float2bfloat16_rn(__bfloat162float(__float2bfloat16_rn(acc)) * gsc));
+}
+constexpr int WBLK = 4608, WBLK_CODES = 4096, WBLK_SC = 512, KBLOCKS = 64;
+constexpr int NT_A = 2 * ID / 128, NT_B = HD / 128;
+constexpr int UNIT_BYTES = 36864;
+constexpr int CE_OFF = 0, XREADY_OFF = 32, XREADY_INTS = 160, DONEAS_OFF = XREADY_OFF + XREADY_INTS;
+constexpr int DONEAS_INTS = (32 + EMAX / 32 + 8) * 16, GRID_OFF = DONEAS_OFF + DONEAS_INTS, FLAG_INTS = GRID_OFF + 4;
+constexpr int GRID_STARTED = 0, GRID_NEXT_PAIR = 1, GRID_NEXT_CHUNK = 2, GRID_NEXT_B = 3;
+constexpr int B_QUEUE = 8, B_DONE = -1, B_LEAVE = -2;
+constexpr int FIX_FLOATS_PER_WG = 8 * 512;
+
+struct Params {
+  const float* gsA; const float* gsB;
+  const __nv_bfloat16* normw;
+  const __nv_bfloat16* pre_norm_w;
+  const unsigned char* w13; const unsigned char* w2;
+  const __nv_bfloat16* x; const int* topk_ids; const float* topk_w;
+  const int* local_start;
+  __nv_bfloat16* xA; __nv_bfloat16* xB;
+  float* ybuf;
+  float* fix; int* fixcnt;
+  int* xready; int* doneAs; int* ce;
+  int* grid_ctr;
+  __nv_bfloat16* out;
+  int M;
+  uint32_t zero;
+};
+
+struct Smem {
+  uint64_t bars[24];
+  int wglast[4];
+  int wcp[JMAX + 1];
+  int wcpB[JMAX + 1];
+  int jrow[JMAX + 1];
+  uint32_t wtot;
+  uint32_t wtotB;
+  unsigned long long wpk[2];
+  int wgr[2];
+  int seq;
+  int preissued;
+  int preissuedB;
+  int fpair;
+  int rank;
+  int gchunk;
+  int bqn;
+  int4 bq[B_QUEUE];
+  int cnt[64], off[64];
+  int wc[NW][32];
+  int jE[JMAX], jS[JMAX], jC[JMAX];
+  int njF, njS;
+  float nred[2][GATHER_BATCH][NW];
+  signed char eid[EMAX];
+  short ent[EMAX];
+  short pos[EMAX];
+};
+
+SGL_DEVICE int muldiv_g(int a, int c, int G, float rG) {
+  const int p = a * c;
+  int q = __float2int_rz((float)p * rG);
+  if (q * G > p) --q;
+  else if ((q + 1) * G <= p) ++q;
+  return q;
+}
+SGL_DEVICE uint32_t bmul2l(uint32_t a, uint32_t b) {
+  __nv_bfloat162 r = __hmul2(*reinterpret_cast<__nv_bfloat162*>(&a), __low2bfloat162(*reinterpret_cast<__nv_bfloat162*>(&b)));
+  return *reinterpret_cast<uint32_t*>(&r);
+}
+SGL_DEVICE uint32_t bmul2h(uint32_t a, uint32_t b) {
+  __nv_bfloat162 r = __hmul2(*reinterpret_cast<__nv_bfloat162*>(&a), __high2bfloat162(*reinterpret_cast<__nv_bfloat162*>(&b)));
+  return *reinterpret_cast<uint32_t*>(&r);
+}
+SGL_DEVICE void st_keep_bf16(__nv_bfloat16* a, __nv_bfloat16 v) {
+  asm volatile("st.global.L2::cache_hint.b16 [%0], %1, %2;\n" ::"l"(a), "h"(*reinterpret_cast<unsigned short*>(&v)), "l"(L2_EVICT_LAST) : "memory");
+}
+SGL_DEVICE void st_keep_f32(float* a, float v) {
+  asm volatile("st.global.L2::cache_hint.b32 [%0], %1, %2;\n" ::"l"(a), "f"(v), "l"(L2_EVICT_LAST) : "memory");
+}
+extern __shared__ __align__(16) unsigned char smem_raw[];
+SGL_DEVICE int ld_acquire(const int* p) {
+  int v;
+  asm volatile("ld.acquire.gpu.global.b32 %0, [%1];\n" : "=r"(v) : "l"(p));
+  return v;
+}
+SGL_DEVICE uint32_t smem_u32(const void* p) { return (uint32_t)__cvta_generic_to_shared(p); }
+SGL_DEVICE void mbar_init(uint64_t* bar, int count) {
+  asm volatile("mbarrier.init.shared::cta.b64 [%0], %1;\n" ::"r"(smem_u32(bar)), "r"(count));
+}
+SGL_DEVICE void mbar_arrive1(uint64_t* bar) {
+  asm volatile("mbarrier.arrive.shared::cta.b64 _, [%0];\n" ::"r"(smem_u32(bar)) : "memory");
+}
+SGL_DEVICE void mbar_wait(uint64_t* bar, uint32_t parity) {
+  asm volatile(
+      "{\n .reg .pred p;\n WAIT_%=:\n mbarrier.try_wait.parity.shared::cta.b64 p, [%0], %1;\n @!p bra WAIT_%=;\n}\n"
+      ::"r"(smem_u32(bar)), "r"(parity) : "memory");
+}
+SGL_DEVICE void mbar_expect_tx(uint64_t* bar, uint32_t bytes) {
+  asm volatile("mbarrier.arrive.expect_tx.shared::cta.b64 _, [%0], %1;\n" ::"r"(smem_u32(bar)), "r"(bytes) : "memory");
+}
+SGL_DEVICE void red_release_add(int* p, int v) {
+  asm volatile("red.release.gpu.global.add.s32 [%0], %1;\n" ::"l"(p), "r"(v) : "memory");
+}
+SGL_DEVICE void wg_bar_sync(int wg) { asm volatile("bar.sync %0, 128;\n" ::"r"(3 + wg) : "memory"); }
+SGL_DEVICE void slot_proxy_fence() { asm volatile("fence.proxy.async.shared::cta;\n" ::: "memory"); }
+SGL_DEVICE uint64_t wg_desc(uint32_t saddr, uint32_t lbo, uint32_t sbo) {
+  return (uint64_t)((saddr >> 4) & 0x3FFF) | ((uint64_t)((lbo >> 4) & 0x3FFF) << 16) | ((uint64_t)((sbo >> 4) & 0x3FFF) << 32);
+}
+SGL_DEVICE void wg_fence() { asm volatile("wgmma.fence.sync.aligned;\n" ::: "memory"); }
+SGL_DEVICE void wg_commit() { asm volatile("wgmma.commit_group.sync.aligned;\n" ::: "memory"); }
+template <int N>
+SGL_DEVICE void wg_wait() { asm volatile("wgmma.wait_group.sync.aligned %0;\n" ::"n"(N) : "memory"); }
+
+SGL_DEVICE void dq3(uint32_t q, uint32_t& r0, uint32_t& r1, uint32_t& r2, uint32_t& r3) {
+  constexpr uint32_t M = 0x81C081C0u;
+  r0 = q & M;
+  r1 = __funnelshift_l(q, q, 13) & M;
+  r2 = __funnelshift_l(q, q, 10) & M;
+  r3 = ((q & 0x001B001Bu) * 0x1084u) & M;
+}
+
+SGL_DEVICE void wgs_dequant(const uint4& cw, const uint2& sc, int js, uint32_t k16c, uint32_t (&a)[4]) {
+  const uint32_t q = js == 0 ? cw.x : js == 1 ? cw.y : js == 2 ? cw.z : cw.w;
+  uint32_t r0, r1, r2, r3;
+  dq3(q, r0, r1, r2, r3);
+  const uint32_t sw = js < 2 ? sc.x : sc.y, sb = (uint32_t)(js & 1) * 2u;
+  const uint32_t sgp = __byte_perm(sw, 0u, 0x4040u | sb | ((sb + 1u) << 8)) * k16c + 0x5C005C00u;
+  a[0] = bmul2l(r0, sgp); a[1] = bmul2h(r1, sgp);
+  a[2] = bmul2l(r2, sgp); a[3] = bmul2h(r3, sgp);
+}
+__device__ void route(const Params& p, Smem& S) {
+  const int tid = threadIdx.x, lane = tid & 31, warp = warp_index(tid);
+  const int E = p.M * 8;
+  const int lo = __ldg(p.local_start);
+  const int CH = ((E + NW * 32 - 1) / (NW * 32)) * 32;
+  const int i0 = warp * CH, i1 = min(E, i0 + CH);
+  if (tid < NW * 32) S.wc[tid >> 5][tid & 31] = 0;
+  {
+    constexpr int LPT = (EMAX / 4 + NT - 1) / NT;
+    int4 ev[LPT];
+    const int E4 = E >> 2;
+    for (int k = 0; k < LPT; ++k) {
+      const int i4 = tid + k * NT;
+      ev[k] = i4 < E4 ? __ldg(reinterpret_cast<const int4*>(p.topk_ids) + i4) : make_int4(0, 0, 0, 0);
+    }
+    for (int k = 0; k < LPT; ++k) {
+      const int i4 = tid + k * NT;
+      if (i4 < E4) {
+        const int v[4] = {ev[k].x - lo, ev[k].y - lo, ev[k].z - lo, ev[k].w - lo};
+        const auto local_eid = [](int e) { return (signed char)((e >= 0 && e < NLOC) ? e : -1); };
+        char4 c;
+        c.x = local_eid(v[0]);
+        c.y = local_eid(v[1]);
+        c.z = local_eid(v[2]);
+        c.w = local_eid(v[3]);

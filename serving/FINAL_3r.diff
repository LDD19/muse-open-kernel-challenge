+  pdl_enter();
+  if (zn > 0 && blockIdx.x == 0)
+    for (int i = threadIdx.x; i < zn; i += BND_TPB) zp[i] = 0;
+  constexpr int H = 8192, C = H / (BND_TPB * 8), NW = BND_TPB / 32;
+  const size_t row = blockIdx.x;
+  const int tid = threadIdx.x;
+  __shared__ float red[2][NW];
+  float b[C * 8], s[C * 8];
+  const __nv_bfloat16* br = branch + row * H;
+  const float* sr = stream + row * H;
+  for (int c = 0; c < C; ++c) {
+    const int off = c * BND_TPB * 8 + tid * 8;
+    const uint4 v = *reinterpret_cast<const uint4*>(br + off);
+    const float4 s0 = *reinterpret_cast<const float4*>(sr + off), s1 = *reinterpret_cast<const float4*>(sr + off + 4);
+    const __nv_bfloat162* h = reinterpret_cast<const __nv_bfloat162*>(&v);
+    for (int i = 0; i < 4; ++i) { float2 f = __bfloat1622float2(h[i]); b[c * 8 + 2 * i] = f.x; b[c * 8 + 2 * i + 1] = f.y; }
+    f4x2(s + c * 8, s0, s1);
+    if constexpr (MODE == 2) {
+      const uint4 u = *reinterpret_cast<const uint4*>(br1 + row * H + off);
+      const __nv_bfloat162* hu = reinterpret_cast<const __nv_bfloat162*>(&u);
+      const float r1p = rio[row];
+      float av[8], bv[8];
+      ldg8(alpha1 + off, av);
+      ldg8(beta1 + off, bv);
+      for (int i = 0; i < 4; ++i) {
+        const float2 f = __bfloat1622float2(hu[i]);
+        s[c * 8 + 2 * i] = __fmaf_rn(av[2 * i], s[c * 8 + 2 * i], bv[2 * i] * qk_bf16r(f.x * r1p));
+        s[c * 8 + 2 * i + 1] = __fmaf_rn(av[2 * i + 1], s[c * 8 + 2 * i + 1], bv[2 * i + 1] * qk_bf16r(f.y * r1p));
+      }
+    }
+  }
+  float ss = 0.f;
+  for (int c = 0; c < C; ++c) {
+    const int off = c * BND_TPB * 8 + tid * 8;
+    if constexpr (GPOST) {
+      const float4 g0 = g1p4(gpost + off), g1 = g1p4(gpost + off + 4);
+      b[c * 8 + 0] *= g0.x; b[c * 8 + 1] *= g0.y; b[c * 8 + 2] *= g0.z; b[c * 8 + 3] *= g0.w;
+      b[c * 8 + 4] *= g1.x; b[c * 8 + 5] *= g1.y; b[c * 8 + 6] *= g1.z; b[c * 8 + 7] *= g1.w;
+      for (int i = 0; i < 8; ++i) b[c * 8 + i] = qk_bf16r(b[c * 8 + i]);
+    }
+    for (int i = 0; i < 8; ++i) ss += b[c * 8 + i] * b[c * 8 + i];
+  }
+  const float tot = block_total<NW, !GPOST>(ss, red[0], tid);
+  const float r1 = rsqrtf(tot / H + 1e-8f);
+  if constexpr (MODE == 1) {
+    if (tid == 0) rio[row] = r1;
+  }
+  float ss2 = 0.f;
+  float* so = sout + row * H;
+  for (int c = 0; c < C; ++c) {
+    const int off = c * BND_TPB * 8 + tid * 8;
+    float av[8], bv[8];
+    ldg8(alpha + off, av);
+    ldg8(beta + off, bv);
+    for (int i = 0; i < 8; ++i) {
+      if constexpr (MODE == 0) s[c * 8 + i] = av[i] * s[c * 8 + i] + bv[i] * qk_bf16r(b[c * 8 + i] * r1);
+      else s[c * 8 + i] = __fmaf_rn(av[i], s[c * 8 + i], bv[i] * qk_bf16r(b[c * 8 + i] * r1));
+      ss2 += s[c * 8 + i] * s[c * 8 + i];
+    }
+    if constexpr (MODE != 1) {
+      float4 o0 = make_float4(s[c * 8 + 0], s[c * 8 + 1], s[c * 8 + 2], s[c * 8 + 3]), o1 = make_float4(s[c * 8 + 4], s[c * 8 + 5], s[c * 8 + 6], s[c * 8 + 7]);
+      *reinterpret_cast<float4*>(so + off) = o0; *reinterpret_cast<float4*>(so + off + 4) = o1;
+    }
+  }
+  const float tot2 = block_total<NW, !GPOST>(ss2, red[1], tid);
+  const float r2 = rsqrtf(tot2 / H + 1e-5f);
+  __nv_bfloat16* no = nout + row * H;
+  for (int c = 0; c < C; ++c) {
+    const int off = c * BND_TPB * 8 + tid * 8;
+    const float4 g0 = g1p4(gpre + off), g1 = g1p4(gpre + off + 4);
+    const float gv[8] = {g0.x, g0.y, g0.z, g0.w, g1.x, g1.y, g1.z, g1.w};
+    uint4 o;
+    __nv_bfloat162* ho = reinterpret_cast<__nv_bfloat162*>(&o);
+    for (int i = 0; i < 4; ++i) ho[i] = __floats2bfloat162_rn(s[c * 8 + 2 * i] * r2 * gv[2 * i], s[c * 8 + 2 * i + 1] * r2 * gv[2 * i + 1]);
+    *reinterpret_cast<uint4*>(no + off) = o;
+  }
+}
+}

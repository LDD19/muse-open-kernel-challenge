+import functools
+import torch
+import triton
+import triton.language as tl
+@triton.jit
+def _pair_sum(x, N: tl.constexpr):
+    return tl.sum(tl.reshape(x, [N // 2, 2]), axis=1)
+@triton.jit
+def _fma_squares_in_column_order(h, acc, THREADS: tl.constexpr):
+    q = tl.reshape(h, [THREADS, 2, 2, 2])
+    k0, k1 = tl.split(q)
+    k0j0, k0j1 = tl.split(k0)
+    k1j0, k1j1 = tl.split(k1)
+    v0, v4 = tl.split(k0j0)
+    v2, v6 = tl.split(k0j1)
+    v1, v5 = tl.split(k1j0)
+    v3, v7 = tl.split(k1j1)
+    acc = tl.fma(v0, v0, acc)
+    acc = tl.fma(v1, v1, acc)
+    acc = tl.fma(v2, v2, acc)
+    acc = tl.fma(v3, v3, acc)
+    acc = tl.fma(v4, v4, acc)
+    acc = tl.fma(v5, v5, acc)
+    acc = tl.fma(v6, v6, acc)
+    acc = tl.fma(v7, v7, acc)
+    return acc
+@triton.jit
+def _conv_and_add(
+    x_row,
+    delta_row,
+    base_ptr,
+    res_row,
+    col,
+    pos,
+    x_stride,
+    delta_tap_stride,
+    H: tl.constexpr,
+    TAPS: tl.constexpr,
+    GROUP_SIZE: tl.constexpr,
+):
+    group = col // GROUP_SIZE
+    coef = tl.load(base_ptr + col).to(tl.float32) + tl.load(delta_row + group).to(tl.float32)
+    out = coef * tl.load(x_row + col).to(tl.float32)
+    for tap in tl.static_range(1, TAPS):
+        coef = tl.load(base_ptr + tap * H + col).to(tl.float32) + tl.load(
+            delta_row + tap * delta_tap_stride + group
+        ).to(tl.float32)
+        shifted = tl.load(x_row - tap * x_stride + col, mask=(col >= 0) & (pos >= tap), other=0.0).to(tl.float32)
+        out = out + coef * shifted
+    conv = out.to(tl.bfloat16).to(tl.float32)
+    return conv + tl.load(res_row + col).to(tl.float32)
+@triton.jit
+def _conv_finish_add_rmsnorm_kernel(
+    x_ptr,
+    delta_ptr,
+    base_ptr,
+    residual_ptr,
+    weight_ptr,
+    out_ptr,
+    x_stride,
+    delta_stride,
+    delta_tap_stride,
+    residual_stride,
+    out_stride,
+    eps,
+    BLOCK_SIZE: tl.constexpr,
+    H: tl.constexpr,
+    TAPS: tl.constexpr,
+    GROUP_SIZE: tl.constexpr,
+    THREADS: tl.constexpr,
+    LOG2_THREADS: tl.constexpr,
+    VEC: tl.constexpr,
+    NUM_VEC_BLOCKS: tl.constexpr,
+):
+    tl.extra.cuda.gdc_launch_dependents()
+    row = tl.program_id(0).to(tl.int64)
+    pos = row % BLOCK_SIZE
+    x_row = x_ptr + row * x_stride
+    delta_row = delta_ptr + row * delta_stride
+    res_row = residual_ptr + row * residual_stride
+    out_row = out_ptr + row * out_stride
+    tl.static_assert(VEC == 8)
+    col = (
+        tl.arange(0, NUM_VEC_BLOCKS)[:, None, None] * (VEC * THREADS)
+        + tl.arange(0, THREADS)[None, :, None] * VEC
+        + tl.arange(0, VEC)[None, None, :]
+    )
+    h = _conv_and_add(x_row, delta_row, base_ptr, res_row, col, pos, x_stride, delta_tap_stride, H, TAPS, GROUP_SIZE)
+    block = tl.arange(0, NUM_VEC_BLOCKS)[:, None, None]
+    acc = tl.zeros([THREADS], dtype=tl.float32)
+    for b in tl.static_range(NUM_VEC_BLOCKS):
+        h_b = tl.sum(tl.where(block == b, h, 0.0), axis=0)
+        acc = _fma_squares_in_column_order(h_b, acc, THREADS)
+    for level in tl.static_range(LOG2_THREADS):
+        acc = _pair_sum(acc, THREADS >> level)
+    total = tl.sum(acc, axis=0)
+    rstd = tl.math.rsqrt(total / H + eps)
+
+    weight = tl.load(weight_ptr + col).to(tl.float32) + 0.0
+    tl.store(res_row + col, h.to(tl.bfloat16))
+    tl.store(out_row + col, (h * rstd * weight).to(tl.bfloat16))
+@functools.cache
+def flashinfer_row_layout(hidden_size:int,device_index:int):
+  try:

+inline void hopper_boundary_rc(TensorView branch, TensorView stream, TensorView alpha, TensorView beta, TensorView gpre,
+    TensorView sout, TensorView nout, int64_t mode, TensorView zero_or_gpost, TensorView br1, TensorView rio,
+    TensorView alpha1, TensorView beta1) {
+  using namespace muse_hopper_moe;
+  const int T = static_cast<int>(rio.size(0));
+  CHECK_HOST(mode == 1 || mode == 2) << "hopper_boundary_rc mode";
+  if (T == 0) return;
+  const bool m1 = mode == 1;
+  auto* k = m1 ? boundary_kernel<false, 1> : boundary_kernel<true, 2>;
+  k<<<T, BND_TPB, 0, stream_of(rio)>>>(
+      ptr<const __nv_bfloat16>(branch), ptr<const float>(stream),
+      m1 ? static_cast<const __nv_bfloat16*>(nullptr) : ptr<const __nv_bfloat16>(zero_or_gpost), ptr<const float>(alpha),
+      ptr<const float>(beta), ptr<const __nv_bfloat16>(gpre), ptr<float>(sout), ptr<__nv_bfloat16>(nout),
+      m1 ? ptr<int>(zero_or_gpost) : static_cast<int*>(nullptr), m1 ? static_cast<int>(zero_or_gpost.numel()) : 0,
+      ptr<const __nv_bfloat16>(br1), ptr<float>(rio), ptr<const float>(alpha1), ptr<const float>(beta1));
+  CHECK_CUDA(cudaGetLastError()) << "hopper_boundary_rc launch";

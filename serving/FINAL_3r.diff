+// dq3 decode layout adapted from ZhimaoL/sglang okc_patch pg (Apache-2.0). Bit positions in q (m0, m1, m2, sign):
+//   a0: code A (6, 7, 8, 15),   code B (22, 23, 24, 31)   q & M
+//   a1: code A (25, 26, 27, 2), code B (9, 10, 11, 18)    rotl(q, 13) & M
+//   a2: code A (28, 29, 30, 5), code B (12, 13, 14, 21)   rotl(q, 10) & M
+//   a3: code A (4, 0, 1, 3),    code B (20, 16, 17, 19)   ((q & 0x001B001B) * 0x1084) & M   (copies << 2, 7, 12)
+// 5 LOP3 + 2 SHF + 1 IMAD per 8 weights at every tile width.
+DEVI void convert8(uint32_t q, uint32_t sb, uint32_t (&a)[4]) {
+  const __nv_bfloat162 s = u32_bf162(sb);
+  const __nv_bfloat162 slo = __low2bfloat162(s), shi = __high2bfloat162(s);
+  constexpr uint32_t M = 0x81C081C0u;
+  const uint32_t r0 = q & M;
+  const uint32_t r2 = __funnelshift_l(q, q, 10) & M;
+  const uint32_t r1 = __funnelshift_l(q, q, 13) & M;
+  const uint32_t r3 = ((q & 0x001B001Bu) * 0x1084u) & M;
+  a[0] = bf162_u32(__hmul2(u32_bf162(r0), slo));
+  a[1] = bf162_u32(__hmul2(u32_bf162(r1), shi));
+  a[2] = bf162_u32(__hmul2(u32_bf162(r2), slo));
+  a[3] = bf162_u32(__hmul2(u32_bf162(r3), shi));
+}
+DEVI void convert_j(const uint4& wq, const uint2& sc, int j, uint32_t m16, uint32_t (&a)[4]) {
+  const uint32_t q = j == 0 ? wq.x : j == 1 ? wq.y : j == 2 ? wq.z : wq.w;
+  const uint32_t sw = j < 2 ? sc.x : sc.y;
+  convert8(q, scale_pair_sel(sw, j & 1, m16), a);
+}
+DEVI uint32_t opaque_zero() {
+  uint32_t z;
+  asm volatile("mov.u32 %0, 0;" : "=r"(z));
+  return z;
+}
+
+struct Args {
+  const uint8_t* wrep;
+  const uint8_t* xt;
+  const int4* tiles;
+  const int* ntiles;
+  const float* gscale;
+  uint8_t* out;
+  int NT;
+  int* counter;
+  uint32_t mul64;
+  uint32_t mul16;
+};
+
+constexpr int SLOT = 37888;
+constexpr int NSLOT = 4;
+
+constexpr int MOE_KPS32 = 4, MOE_KPS64 = 2, MOE_KPS96 = 2, MOE_KPS128 = 1;
+constexpr int MOE_GROUP4_MAX = 128;
+DEVI constexpr int kps_for(int n) {
+  return n >= 160 ? 1 : (n <= 32 ? MOE_KPS32 : (n <= 64 ? MOE_KPS64 : (n <= 96 ? MOE_KPS96 : MOE_KPS128)));
+}
+
+DEVI uint32_t stg_full_bar(uint32_t bars) { return bars + 16 * NSLOT + 32; }
+DEVI uint32_t stg_empty_bar(uint32_t bars) { return bars + 16 * NSLOT + 40; }
+DEVI void post_job(volatile long long* job, void* dst, int* done, int kind, int amount) {
+  job[0] = (long long)dst;
+  job[1] = (long long)done;
+  reinterpret_cast<volatile int*>(job)[4] = kind;
+  reinterpret_cast<volatile int*>(job)[5] = amount;
+}
+
+#define MOE_FUSED_THREADS 384
+template <int N, int CB = 128>
+DEVI void consumer_item(const Args& p, uint8_t* ring, uint8_t* stg, uint32_t bars, int& slot, uint32_t& ph,
+    int e, int row0, int ntile, bool GATED, int* done, volatile long long* jobq, int& njob) {
+  constexpr int MOE_IMAD_MAXN = 64;
+  const uint32_t zz_ = N <= MOE_IMAD_MAXN ? opaque_zero() : 0u;
+  const uint32_t m16 = N <= MOE_IMAD_MAXN ? p.mul16 : 16u + zz_;
+  constexpr int KPS = kps_for(N);
+  constexpr int XB = N * 128;
+  const int ctid = threadIdx.x - CB;
+  const int wg = ctid >> 7;
+  const int w = (ctid >> 5) & 3;
+  const int lane = ctid & 31;
+  const int g = lane >> 2, t = lane & 3;
+  constexpr bool GROUP4 = N <= MOE_GROUP4_MAX && N != 96;
+  constexpr int MOE_NACC4_MAXN = 32;
+  constexpr int NACC = GROUP4 ? (N <= MOE_NACC4_MAXN ? 4 : 2) : 1;
+  float acc[128];
+  float acc2[128];
+  float acc3[128], acc4[128];
+  for (int i = 0; i < N / 2; ++i) acc[i] = 0.f;
+  for (int i = 0; i < (NACC > 1 ? N / 2 : 0); ++i) acc2[i] = 0.f;
+  for (int i = 0; i < (NACC > 2 ? N / 2 : 0); ++i) acc3[i] = 0.f;
+  for (int i = 0; i < (NACC > 3 ? N / 2 : 0); ++i) acc4[i] = 0.f;
+  uint32_t afrag[GROUP4 ? 8 : 2][4];
+  int prev = -1;
+  const int woff = ((wg * 4 + w) * 32 + lane) * 16, soff = 4096 + ((wg * 4 + w) * 8 + g) * 8;
+  mbar_wait(bars + 8 * slot, ph);
+  uint4 nwq = *reinterpret_cast<const uint4*>(ring + slot * SLOT + KPS * XB + woff);
+  uint2 nsc = *reinterpret_cast<const uint2*>(ring + slot * SLOT + KPS * XB + soff);
+  auto stage = [&]<int PAR>(int it) {
+    uint8_t* st = ring + slot * SLOT;
+    const uint8_t* wbase = st + KPS * XB + woff;
+    const uint8_t* sbase = st + KPS * XB + soff;
+    const uint64_t dbase = desc_sw128(smem_u32(st));
+    if (it > 0) {
+      mbar_wait(bars + 8 * slot, ph);
+      nwq = *reinterpret_cast<const uint4*>(wbase);
+      nsc = *reinterpret_cast<const uint2*>(sbase);
+    }
+    for (int kk = 0; kk < KPS; ++kk) {
+      const uint4 wq = nwq;
+      const uint2 sc = nsc;
+      if (kk + 1 < KPS) {
+        nwq = *reinterpret_cast<const uint4*>(wbase + (kk + 1) * WBLK);
+        nsc = *reinterpret_cast<const uint2*>(sbase + (kk + 1) * WBLK);
+      }
+      const uint64_t desc = dbase + (uint64_t)((kk * XB) >> 4);
+      if constexpr (GROUP4) {
+        for (int j = 0; j < 4; ++j)
+          convert_j(wq, sc, j, m16, afrag[((kk + PAR) & 1) * 4 + j]);
+        wg_fence();
+#pragma unroll
+        for (int j = 0; j < 4; ++j)
+          wgmma_rs<N>(NACC > 2 ? (((kk + PAR) & 1) ? ((j & 1) ? acc4 : acc2) : ((j & 1) ? acc3 : acc))
+                  : ((NACC > 1 && ((kk + PAR) & 1)) ? acc2 : acc),
+              afrag[((kk + PAR) & 1) * 4 + j], desc + 2 * j, 1);
+        wg_commit();
+        wg_wait<1>();
+        if (kk == 0 && prev >= 0) mbar_arrive(bars + 8 * NSLOT + 8 * prev);
+      } else {
+        for (int j = 0; j < 4; ++j) {
+          convert_j(wq, sc, j, m16, afrag[j & 1]);
+          wg_fence();
+          wgmma_rs<N>(acc, afrag[j & 1], desc + 2 * j, 1);
+          wg_commit();
+          wg_wait<1>();
+          if (kk == 0 && j == 0 && prev >= 0) mbar_arrive(bars + 8 * NSLOT + 8 * prev);
+        }
+      }
+    }
+    prev = slot;
+    if (++slot == NSLOT) { slot = 0; ph ^= 1; }
+  };
+  if constexpr (KPS % 2 == 0) {
+    for (int it = 0; it < KS / KPS; ++it) stage.template operator()<0>(it);
+  } else {
+    for (int it = 0; it < KS / KPS; it += 2) {
+      stage.template operator()<0>(it);
+      stage.template operator()<1>(it + 1);
+    }
+  }
+  wg_wait<0>();
+  mbar_arrive(bars + 8 * NSLOT + 8 * prev);
+  if constexpr (NACC > 3) {
+    for (int i = 0; i < N / 2; ++i) acc[i] = (acc[i] + acc3[i]) + (acc2[i] + acc4[i]);
+  } else if constexpr (NACC > 1) {
+    for (int i = 0; i < N / 2; ++i) acc[i] += acc2[i];
+  }
+  const float cs = p.gscale[e] * 128.f;
+  const __nv_bfloat162 cs2 = __float2bfloat162_rn(cs);
+  mbar_wait(stg_empty_bar(bars), (njob & 1) ^ 1);
+  if (GATED) {
+    const int q = wg * 4 + w;
+    uint8_t* const upl = stg + N * 128;
+    if constexpr (N == 8) {
+      const uint32_t rg = bf162_u32(marlin_out2(acc[0], acc[1], cs2));
+      const uint32_t ru = bf162_u32(marlin_out2(acc[2], acc[3], cs2));
+      const int rr = lane & 7;
+      const int off = rr * 128 + ((q ^ rr) << 4);
+      stmatrix_x1_trans(smem_u32(stg + off), rg);
+      stmatrix_x1_trans(smem_u32(upl + off), ru);
+    }
+    for (int j4 = 0; j4 < N / 32; ++j4) {
+      uint32_t rg[4], ru[4];
+      for (int u = 0; u < 4; ++u) {
+        const int jj = 4 * j4 + u;
+        rg[u] = bf162_u32(marlin_out2(acc[4 * jj], acc[4 * jj + 1], cs2));
+        ru[u] = bf162_u32(marlin_out2(acc[4 * jj + 2], acc[4 * jj + 3], cs2));
+      }
+      const int rr = lane & 7, tokr = 8 * (4 * j4 + (lane >> 3)) + rr;
+      const int off = tokr * 128 + ((q ^ rr) << 4);
+      stmatrix_x4_trans(smem_u32(stg + off), rg);
+      stmatrix_x4_trans(smem_u32(upl + off), ru);
+    }
+    if (ctid == 0) post_job(jobq, p.out + (size_t)row0 * 8192 + (size_t)ntile * N * 128, done, 0, N * 128);
+  } else {
+    const int c0 = (wg * 4 + w) * 16 + g;
+    auto gemm2_part = [&]<int part, int NJ>() {
+      if constexpr (NJ >= 2) {
+#pragma unroll
+        for (int j2 = 0; j2 < NJ / 2; ++j2) {
+          uint32_t r[4];
+          for (int u = 0; u < 2; ++u) {
+            const int ai = 4 * (2 * j2 + u + part * 16);
+            r[2 * u] = bf162_u32(marlin_out2(acc[ai], acc[ai + 1], cs2));
+            r[2 * u + 1] = bf162_u32(marlin_out2(acc[ai + 2], acc[ai + 3], cs2));
+          }
+          const int m = lane >> 3, rr = lane & 7;
+          const int tl = part * 128 + 8 * (2 * j2 + (m >> 1)) + rr;
+          const uint32_t addr = smem_u32(stg + tl * 272 + ((wg * 4 + w) * 16 + 8 * (m & 1)) * 2);
+          stmatrix_x4_trans(addr, r);
+        }
+      } else {
+        for (int jj = 0; jj < NJ; ++jj) {
+          for (int b = 0; b < 2; ++b) {
+            const int tl = part * 128 + 8 * jj + 2 * t + b;
+            const int ai = 4 * (jj + part * 16) + b;
+            __nv_bfloat16* r = reinterpret_cast<__nv_bfloat16*>(stg + tl * 272);
+            const __nv_bfloat162 o = marlin_out2(acc[ai], acc[ai + 2], cs2);
+            r[c0] = __low2bfloat16(o);
+            r[c0 + 8] = __high2bfloat16(o);
+          }
+        }
+      }
+    };
+    gemm2_part.template operator()<0, (N > 128 ? 16 : N / 8)>();
+    if constexpr (N > 128) gemm2_part.template operator()<1, (N - 128) / 8>();
+    if (ctid == 0) post_job(jobq, p.out + ((size_t)row0 * 4096 + ntile * 128) * 2, nullptr, 1, N);
+  }
+  mbar_arrive(stg_full_bar(bars));
+  ++njob;
+}
+
+#define MOE_CB 128
+#define REL_LANES 32
+DEVI void slot_proxy_fence() { asm volatile("fence.proxy.async.shared::cta;" ::: "memory"); }
+struct FusedArgs {
+  Args g1, g2;
+  int* done;
+  int flags;
+  const long long* rdst;
+};
+
+template <int FINE, bool RB = false>
+__global__ void __launch_bounds__(MOE_FUSED_THREADS, 1) moe_fused_persistent(FusedArgs fa) {
+  pdl_enter();
+  extern __shared__ __align__(1024) uint8_t smem_raw[];
+  const uint32_t raw = smem_u32(smem_raw);
+  const uint32_t pad = ((raw + 1023) & ~1023u) - raw;
+  uint8_t* base = smem_raw + pad;
+  const uint32_t bars = smem_u32(base);
+  const uint32_t ibar = bars + 16 * NSLOT;
+  volatile int* iring = reinterpret_cast<volatile int*>(base + 512);
+  uint8_t* ring = base + 1024;
+  uint8_t* stg = ring + NSLOT * SLOT;
+  volatile long long* jobq = reinterpret_cast<volatile long long*>(base + 256);
+  if (threadIdx.x == 0) {
+    mbar_init(stg_full_bar(bars), 256);
+    mbar_init(stg_empty_bar(bars), 96);
+    for (int s = 0; s < NSLOT; ++s) {
+      mbar_init(bars + 8 * s, 1);
+      mbar_init(bars + 8 * NSLOT + 8 * s, 8 * REL_LANES);
+    }
+    for (int k = 0; k < 2; ++k) {
+      mbar_init(ibar + 8 * k, 1);
+      mbar_init(ibar + 16 + 8 * k, 256);
+    }
+    asm volatile("fence.mbarrier_init.release.cluster;" ::: "memory");
+  }
+  __syncthreads();
+  const int nt = *fa.g1.ntiles;
+  const int n1 = nt * fa.g1.NT, nitems = n1 + nt * fa.g2.NT;
+  int slot = 0;
+  uint32_t ph = 0;
+  if (threadIdx.x < 128) {
+    asm volatile("setmaxnreg.dec.sync.aligned.u32 40;\n");
+    if (threadIdx.x == 0) {
+      int k = 0;
+      uint32_t iph = 0;
+      while (true) {
+        mbar_wait(ibar + 16 + 8 * k, iph ^ 1);
+        const int item = atomicAdd(fa.g1.counter, 1);
+        iring[k] = item;
+        mbar_arrive(ibar + 8 * k);
+        if (item >= nitems) break;
+        const bool second = item >= n1;
+        const Args& p = second ? fa.g2 : fa.g1;
+        const int it2 = second ? item - n1 : item;
+        const int tile = it2 / p.NT, ntile = it2 - tile * p.NT;
+        const int4 ti = p.tiles[tile];
+        const int e = ti.x, row0 = ti.y, n = ti.z;
+        if (second) {
+          const int need = fa.g1.NT;
+          int v;
+          while (true) {
+            asm volatile("ld.acquire.gpu.global.b32 %0, [%1];" : "=r"(v) : "l"(fa.done + tile) : "memory");
+            if (v >= need) break;
+            __nanosleep(64);
+          }
+          asm volatile("fence.proxy.async.global;" ::: "memory");
+        }
+        const int kps = kps_for(n);
+        const uint32_t xb = n * 128;
+        const uint8_t* wsrc = p.wrep + ((size_t)(e * p.NT + ntile) * KS) * WBLK;
+        const uint8_t* xsrc = p.xt + (size_t)row0 * 8192;
+        for (int j = 0; j < MOE_L2PF && j < KS / kps; ++j) prefetch_l2(wsrc + (size_t)j * kps * WBLK, kps * WBLK);
+        for (int it = 0; it < KS / kps; ++it) {
+          if (it + MOE_L2PF < KS / kps) prefetch_l2(wsrc + (size_t)(it + MOE_L2PF) * kps * WBLK, kps * WBLK);
+          mbar_wait(bars + 8 * NSLOT + 8 * slot, ph ^ 1);
+          slot_proxy_fence();
+          const uint32_t full = bars + 8 * slot;
+          const bool lx = !(fa.flags & 1) || it < NSLOT, lw = !(fa.flags & 2) || it < NSLOT;
+          mbar_expect_tx(full, (lx ? kps * xb : 0) + (lw ? kps * WBLK : 0) + (!lx && !lw ? 16 : 0));
+          const uint32_t dst = smem_u32(ring + slot * SLOT);
+          if (lx) bulk_g2s(dst, xsrc + (size_t)it * kps * xb, kps * xb, full);
+          if (lw) bulk_g2s(dst + kps * xb, wsrc + (size_t)it * kps * WBLK, kps * WBLK, full);
+          if (!lx && !lw) bulk_g2s(dst, xsrc, 16, full);
+          if (++slot == NSLOT) { slot = 0; ph ^= 1; }
+        }
+        k ^= 1;
+        if (k == 0) iph ^= 1;
+      }
+    } else if (threadIdx.x >= 32) {
+      constexpr int NCP = 96;
+      const int ptid = threadIdx.x - 32;
+      for (int seen = 0;; ++seen) {
+        mbar_wait(stg_full_bar(bars), seen & 1);
+        uint8_t* dst = reinterpret_cast<uint8_t*>(jobq[0]);
+        int* d = reinterpret_cast<int*>(jobq[1]);
+        const int kind = reinterpret_cast<volatile int*>(jobq)[4], amount = reinterpret_cast<volatile int*>(jobq)[5];
+        if (kind == 2) break;
+        if (kind == 0) {
+          const uint4* gp = reinterpret_cast<const uint4*>(stg);
+          const uint4* up = reinterpret_cast<const uint4*>(stg + amount);
+          uint4* out = reinterpret_cast<uint4*>(dst);
+          for (int i = ptid; i < amount / 16; i += NCP) {
+            const uint4 gq = gp[i], uq = up[i];
+            out[i] = make_uint4(silu_mul2(gq.x, uq.x), silu_mul2(gq.y, uq.y), silu_mul2(gq.z, uq.z), silu_mul2(gq.w, uq.w));
+          }
+        } else if constexpr (RB) {
+          const size_t off = dst - fa.g2.out;
+          const long long* rd = fa.rdst + (off >> 13);
+          for (int i = ptid; i < amount * 16; i += NCP) {
+            const int tl = i >> 4, c = i & 15;
+            *reinterpret_cast<uint4*>(reinterpret_cast<uint8_t*>(rd[tl]) + (off & 8191) + c * 16) =
+                *reinterpret_cast<const uint4*>(stg + tl * 272 + c * 16);
+          }
+        } else {
+          for (int i = ptid; i < amount * 16; i += NCP) {
+            const int tl = i >> 4, c = i & 15;
+            *reinterpret_cast<uint4*>(dst + (size_t)tl * 8192 + c * 16) = *reinterpret_cast<const uint4*>(stg + tl * 272 + c * 16);
+          }
+        }
+        mbar_arrive(stg_empty_bar(bars));
+        if (d) {
+          named_bar_sync(2, NCP);
+          if (ptid == 0) {
+            asm volatile("fence.acq_rel.gpu;" ::: "memory");
+            atomicAdd(d, 1);
+          }
+        }
+      }
+    }
+  } else {
+    asm volatile("setmaxnreg.inc.sync.aligned.u32 232;\n");
+    int k = 0;
+    uint32_t iph = 0;
+    int njob = 0;
+    while (true) {
+      mbar_wait(ibar + 8 * k, iph);
+      const int item = iring[k];
+      named_bar_sync(1, 256);
+      mbar_arrive(ibar + 16 + 8 * k);
+      if (item >= nitems) {
+        mbar_wait(stg_empty_bar(bars), (njob & 1) ^ 1);
+        if (threadIdx.x == MOE_CB) post_job(jobq, nullptr, nullptr, 2, 0);
+        mbar_arrive(stg_full_bar(bars));
+        break;
+      }
+      k ^= 1;
+      if (k == 0) iph ^= 1;
+      const bool first = item < n1;
+      const Args& p = first ? fa.g1 : fa.g2;
+      const int it2 = first ? item : item - n1;
+      const int tile = it2 / p.NT, ntile = it2 - tile * p.NT;
+      const int4 ti = p.tiles[tile];
+      int* dn = first ? fa.done + tile : nullptr;
+#define MOE_RUN_ITEM(N) consumer_item<N, MOE_CB>(p, ring, stg, bars, slot, ph, ti.x, ti.y, ntile, first, dn, jobq, njob)
+      if constexpr (FINE == 2) {
+        switch (ti.z) {
+          case 8: MOE_RUN_ITEM(8); break;
+          case 32: MOE_RUN_ITEM(32); break;
+          case 96: MOE_RUN_ITEM(96); break;
+          case 128: MOE_RUN_ITEM(128); break;
+          case 192: MOE_RUN_ITEM(192); break;
+          default: MOE_RUN_ITEM(256); break;
+        }
+      } else {
+        switch (ti.z) {
+          case 32: MOE_RUN_ITEM(32); break;
+          case 64: MOE_RUN_ITEM(64); break;
+          case 128: MOE_RUN_ITEM(128); break;
+          case 160: if constexpr (FINE != 0) MOE_RUN_ITEM(160); break;
+          case 192: if constexpr (FINE != 0) MOE_RUN_ITEM(192); break;
+          default: MOE_RUN_ITEM(256); break;
+        }
+      }
+    }
+  }
+}
+
+DEVI int rem_tile(int r, int fine) {
+  if (r == 0) return 0;
+  if (fine == 2 && r <= 8) return 8;
+  if (r <= 32) return 32;
+  if (fine != 2 && r <= 64) return 64;
+  if (!fine) return r <= 128 ? 128 : 256;
+  const int fm = fine == 2 ? 5 : MOE_FINE_MASK;
+  if ((fm & 1) && r <= 96) return 96;
+  if (r <= 128) return 128;
+  if ((fm & 2) && r <= 160) return 160;
+  if ((fm & 4) && r <= 192) return 192;
+  if ((fm & 8) && r <= 224) return 224;
+  return 256;
+}
+DEVI void rem_tiles(int r, int fine, int& na, int& nb) {
+  if (!fine && r > 128 && r <= 192) {
+    na = 128;
+    nb = rem_tile(r - 128, 0);
+  } else {
+    na = rem_tile(r, fine);
+    nb = 0;
+  }
+}
+DEVI void expert_tiles(int c, int fine, int& full, int& r, int& nr, int& nb) {
+  full = c >> 8;
+  r = c & 255;
+  rem_tiles(r, fine, nr, nb);
+  if (fine && full >= 1 && r >= 33 && r <= (fine == 2 ? 64 : 96)) {
+    full -= 1;
+    r += 256;
+    nr = 192;
+    nb = r <= 320 ? 128 : 160;
+  }
+}
+template <int NW, bool EXACT>
+DEVI float block_total(float ss, float* red, int tid) {
+  for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
+  if ((tid & 31) == 0) red[tid >> 5] = ss;
+  __syncthreads();
+  if constexpr (EXACT) {
+    const auto quad = [red](int i) {
+      return __fadd_rn(__fadd_rn(red[i], red[i + 8]), __fadd_rn(red[i + 4], red[i + 12]));
+    };
+    return __fadd_rn(__fadd_rn(quad(0), quad(2)), __fadd_rn(quad(1), quad(3)));
+  } else {
+    float tot = 0.f;
+    for (int i = 0; i < NW; ++i) tot += red[i];
+    return tot;
+  }
+}
+DEVI int warp_incl_sum(int v, int lane) {
+  for (int o = 1; o < 32; o <<= 1) {
+    const int a2 = __shfl_up_sync(0xffffffffu, v, o);
+    if (lane >= o) v += a2;
+  }
+  return v;
+}
+DEVI void plan_warp(const int* __restrict__ counts, int* __restrict__ offsets, int4* __restrict__ tiles,
+    int* __restrict__ ntiles, int* __restrict__ rows_per_expert, int order, int e) {
+  const int fine = order >> 8;
+  order &= 255;
+  int full, r, nr, nb;
+  expert_tiles(counts[e], fine, full, r, nr, nb);
+  const int rows = full * 256 + nr + nb;
+  const int nt = full + (nr > 0) + (nb > 0);
+  int cnt[10];
+  cnt[0] = rows;
+  for (int k = 0; k < 8; ++k) cnt[1 + k] = (k == 0 ? full : 0) + (nr == 256 - 32 * k || (k == 7 && (nr == 16 || nr == 8))) + (nb == 256 - 32 * k);
+  cnt[9] = nt;
+  const bool grp = (order == 3) && nt >= 2;
+  int m1x = grp ? nt : 0;
+  m1x = warp_incl_sum(m1x, e);
+  const int M1 = __shfl_sync(0xffffffffu, m1x, 31);
+  const int m0 = m1x - (grp ? nt : 0);
+  if (grp) {
+    for (int k = 0; k < 8; ++k) cnt[1 + k] = 0;
+  }
+  int incl[10];
+  for (int k = 0; k < 10; ++k)
+    incl[k] = warp_incl_sum(cnt[k], e);
+  int tot[10];
+  for (int k = 0; k < 10; ++k) tot[k] = __shfl_sync(0xffffffffu, incl[k], 31);
+  const int r0 = incl[0] - rows;
+  offsets[e] = r0;
+  rows_per_expert[e] = rows;
+  if (e == 31) *ntiles = tot[9];
+  if (grp) {
+    int q = m0;
+    for (int i = 0; i < full; ++i) tiles[q++] = make_int4(e, r0 + 256 * i, 256, 256);
+    if (nr) tiles[q++] = make_int4(e, r0 + 256 * full, nr, nb ? nr : r);
+    if (nb) tiles[q++] = make_int4(e, r0 + 256 * full + nr, nb, r - nr);
+    return;
+  }
+  if (order == 0) {
+    const int t0 = incl[9] - nt;
+    for (int i = 0; i < full; ++i) tiles[t0 + i] = make_int4(e, r0 + 256 * i, 256, 256);
+    if (nr) tiles[t0 + full] = make_int4(e, r0 + 256 * full, nr, nb ? nr : r);
+    if (nb) tiles[t0 + full + 1] = make_int4(e, r0 + 256 * full + nr, nb, r - nr);
+    return;
+  }
+  int cbase[8];
+  {
+    int acc = 0;
+    for (int k = 0; k < 8; ++k) { cbase[k] = (k == 6) ? 0 : acc; acc = (k == 5) ? 0 : acc + tot[1 + k]; }
+  }
+  const int B = tot[1] + tot[2] + tot[3] + tot[4] + tot[5] + tot[6], S = tot[7] + tot[8];
+  auto pos_big = [&](int k) -> int {
+    if (order == 1 || B == 0) return M1 + k;
+    return M1 + k + min(S, (4 * k * S) / (5 * B));
+  };
+  auto pos_small = [&](int j) -> int {
+    if (order == 1) return M1 + B + j;
+    if (B == 0) return M1 + j;
+    const int lim = (4 * S) / 5;
+    const int bb = j < lim ? (5 * B * (j + 1) + 4 * S - 1) / (4 * S) : B;
+    return M1 + j + bb;
+  };
+  const int p256 = cbase[0] + incl[1] - cnt[1];
+  for (int i = 0; i < full; ++i) tiles[pos_big(p256 + i)] = make_int4(e, r0 + 256 * i, 256, 256);
+  if (nr == 256) tiles[pos_big(p256 + full)] = make_int4(e, r0 + 256 * full, 256, r);
+#pragma unroll
+  for (int k = 1; k < 6; ++k)
+    if (nr == 256 - 32 * k) tiles[pos_big(cbase[k] + incl[1 + k] - 1)] = make_int4(e, r0 + 256 * full, nr, nb ? nr : r);
+  if (nr == 64) tiles[pos_small(cbase[6] + incl[7] - 1)] = make_int4(e, r0 + 256 * full, 64, r);
+  if (nr == 32 || nr == 16 || nr == 8) tiles[pos_small(cbase[7] + incl[8] - 1)] = make_int4(e, r0 + 256 * full, nr, r);
+  if (nb == 64) tiles[pos_small(cbase[6] + incl[7] - 1)] = make_int4(e, r0 + 256 * full + nr, 64, r - nr);
+  if (nb == 128) tiles[pos_big(cbase[4] + incl[5] - 1)] = make_int4(e, r0 + 256 * full + nr, 128, r - nr);
+  if (nb == 160) tiles[pos_big(cbase[3] + incl[4] - 1)] = make_int4(e, r0 + 256 * full + nr, 160, r - nr);
+  if (nb == 32) tiles[pos_small(cbase[7] + incl[8] - 1)] = make_int4(e, r0 + 256 * full + nr, 32, r - nr);
+}

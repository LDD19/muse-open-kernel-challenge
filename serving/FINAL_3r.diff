+from sglang.kernels.ops.attention.muse_spark_qk_norm_rope_store import FusedQKNorm,_triton_config
+if TYPE_CHECKING:
+  from tvm_ffi.module import Module
+_FLAVOUR_PROBE_BITS=(0x43EB0000 ,0x461C4000 ,0x7F800000 ,-0x00800000 ,0x7FC00000 ,-0x00400000 )
+_FP8_CAST_FLAVOUR: dict = {}
+def _detect_fp8_cast_flavour_verify(device: torch.device) -> Optional[tuple[bool, bool]]:
+  bits=torch.tensor(_FLAVOUR_PROBE_BITS,dtype=torch.int32)
+  out = bits.to(device).view(torch.float32).to(torch.float8_e4m3fn)
+  probe=tuple(out.view(torch.uint8).tolist())
+  if probe[:5 ]==(0x7E ,0x7E ,0x7E ,0xFE ,0x7F ):
+    saturates=True
+  elif probe[:5 ]==(0x7F ,0x7F ,0x7F ,0xFF ,0x7F ):
+    saturates=False
+  else:
+    return None
+  if probe[5 ]not in(0x7F ,0xFF ):
+    return None
+  return saturates,probe[5 ]==0xFF
+def fp8_cast_flavour_verify(device: torch.device) -> Optional[tuple[bool, bool]]:
+  key=(device.type,device.index)
+  if key not in _FP8_CAST_FLAVOUR:
+    if torch.cuda.is_current_stream_capturing():
+      return None
+    _FP8_CAST_FLAVOUR[key] = _detect_fp8_cast_flavour_verify(device)
+  return _FP8_CAST_FLAVOUR[key]
+@triton.jit
+def _fp8e4m3fn_bits_verify(x, SATURATE: tl.constexpr, NAN_KEEPS_SIGN: tl.constexpr):
+    f_bits = x.to(tl.uint32, bitcast=True)
+    sign = (f_bits >> 31) << 7
+    f_bits = f_bits & 0x7FFFFFFF
+    overflow = f_bits >= (1087 << 20)
+    is_nan = f_bits > 0x7F800000
+    denorm_mask = tl.full(f_bits.shape, 141 << 23, tl.uint32)
+    denorm_sum = f_bits.to(tl.float32, bitcast=True) + denorm_mask.to(
+        tl.float32, bitcast=True
+    )
+    denorm = (denorm_sum.to(tl.uint32, bitcast=True) - denorm_mask) & 0xFF
+    mant_odd = (f_bits >> 20) & 1
+    normal = ((f_bits - (120 << 23) + 0x7FFFF + mant_odd) >> 20) & 0xFF
+    if SATURATE:
+        normal = tl.where(normal == 0x7F, 0x7E, normal)
+        big = tl.where(is_nan, 0x7F, 0x7E)
+    else:
+        big = tl.full(f_bits.shape, 0x7F, tl.uint32)
+    result = tl.where(f_bits < (121 << 23), denorm, normal)
+    result = tl.where(overflow, big, result) | sign
+    if not NAN_KEEPS_SIGN:
+        result = tl.where(is_nan, 0x7F, result)
+    return result.to(tl.uint8)
+@triton.jit
+def _qk_norm_rope_verify_store_kernel(
+    QKV,
+    Q_OUT,
+    K_OUT,
+    POS,
+    COS_SIN,
+    K_CACHE,
+    V_CACHE,
+    CACHE_LOC,
+    eps,

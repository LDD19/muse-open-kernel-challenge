diff --git a/python/sglang/kernels/jit/csrc/gemm/hopper_bf16_lt_gemm.cuh b/python/sglang/kernels/jit/csrc/gemm/hopper_bf16_lt_gemm.cuh
new file mode 100644
index 0000000000..59430b3cb4
--- /dev/null
+++ b/python/sglang/kernels/jit/csrc/gemm/hopper_bf16_lt_gemm.cuh
@@ -0,0 +1,153 @@
+#pragma once
+
+#include <sgl_kernel/tensor.h>
+
+#include <cublasLt.h>
+#include <string.h>
+
+namespace sglang {
+using tvm::ffi::TensorView;
+namespace hopper_lt {
+constexpr int kMaxHeuristicAlgos = 64;
+
+inline cublasLtHandle_t handle() {
+  static cublasLtHandle_t h = [] {
+    cublasLtHandle_t created = nullptr;
+    CHECK_HOST(cublasLtCreate(&created) == CUBLAS_STATUS_SUCCESS) << "cublasLtCreate failed";
+    return created;
+  }();
+  return h;
+}
+
+inline cublasComputeType_t compute_type(bool tf32) { return tf32 ? CUBLAS_COMPUTE_32F_FAST_TF32 : CUBLAS_COMPUTE_32F; }
+inline cudaDataType_t in_type(bool tf32) { return tf32 ? CUDA_R_32F : CUDA_R_16BF; }
+
+struct Desc {
+  cublasLtMatmulDesc_t op = nullptr;
+  cublasLtMatrixLayout_t la = nullptr, lb = nullptr, lc = nullptr;
+  Desc(int64_t M, int64_t N, int64_t K, bool out_f32, bool tf32) {
+    CHECK_HOST(cublasLtMatmulDescCreate(&op, compute_type(tf32), CUDA_R_32F) == CUBLAS_STATUS_SUCCESS) << "desc";
+    const cublasOperation_t ta = CUBLAS_OP_T, tb = CUBLAS_OP_N;
+    cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_TRANSA, &ta, sizeof(ta));
+    cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_TRANSB, &tb, sizeof(tb));
+    CHECK_HOST(cublasLtMatrixLayoutCreate(&la, in_type(tf32), K, N, K) == CUBLAS_STATUS_SUCCESS) << "layout";
+    CHECK_HOST(cublasLtMatrixLayoutCreate(&lb, in_type(tf32), K, M, K) == CUBLAS_STATUS_SUCCESS) << "layout";
+    CHECK_HOST(cublasLtMatrixLayoutCreate(&lc, out_f32 ? CUDA_R_32F : CUDA_R_16BF, N, M, N) == CUBLAS_STATUS_SUCCESS)
+        << "layout";
+  }
+  ~Desc() {
+    if (lc) cublasLtMatrixLayoutDestroy(lc);
+    if (lb) cublasLtMatrixLayoutDestroy(lb);
+    if (la) cublasLtMatrixLayoutDestroy(la);
+    if (op) cublasLtMatmulDescDestroy(op);
+  }
+  Desc(const Desc&) = delete;
+  Desc& operator=(const Desc&) = delete;
+};
+
+inline void store_algo(const cublasLtMatmulAlgo_t& algo, const TensorView& out) {
+  CHECK_HOST(out.device().device_type == kDLCPU && out.numel() == 64 && out.dtype().bits == 8)
+      << "algo tensor must be a 64-byte CPU uint8 tensor";
+  memcpy(out.data_ptr(), &algo, sizeof(algo));
+}
+
+template <typename T>
+inline T config_attr(const cublasLtMatmulAlgo_t& algo, cublasLtMatmulAlgoConfigAttributes_t attr) {
+  T v{};
+  size_t written = 0;
+  cublasLtMatmulAlgoConfigGetAttribute(&algo, attr, &v, sizeof(v), &written);
+  return v;
+}
+
+}
+
+inline int64_t hopper_lt_find_algo(int64_t M, int64_t N, int64_t K, bool out_f32, bool tf32, int64_t tile,
+    int64_t splitk, int64_t reduction, int64_t custom, int64_t max_workspace, int64_t max_algos, TensorView algo) {
+  using namespace hopper_lt;
+  CHECK_HOST(M > 0 && N > 0 && K > 0 && max_algos > 0 && max_algos <= kMaxHeuristicAlgos && max_workspace >= 0)
+      << "hopper_lt_find_algo args";
+  Desc d(M, N, K, out_f32, tf32);
+  cublasLtMatmulPreference_t pref = nullptr;
+  CHECK_HOST(cublasLtMatmulPreferenceCreate(&pref) == CUBLAS_STATUS_SUCCESS) << "preference";
+  const uint64_t ws = static_cast<uint64_t>(max_workspace);
+  cublasLtMatmulPreferenceSetAttribute(pref, CUBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES, &ws, sizeof(ws));
+  cublasLtMatmulHeuristicResult_t res[kMaxHeuristicAlgos];
+  int n = 0;
+  const cublasStatus_t s = cublasLtMatmulAlgoGetHeuristic(handle(), d.op, d.la, d.lb, d.lc, d.lc, pref,
+      static_cast<int>(max_algos), res, &n);
+  cublasLtMatmulPreferenceDestroy(pref);
+  if (s != CUBLAS_STATUS_SUCCESS) return -1;
+  for (int i = 0; i < n; ++i) {
+    const auto& a = res[i].algo;
+    if (config_attr<int32_t>(a, CUBLASLT_ALGO_CONFIG_TILE_ID) == tile &&
+        config_attr<int32_t>(a, CUBLASLT_ALGO_CONFIG_SPLITK_NUM) == splitk &&
+        config_attr<int32_t>(a, CUBLASLT_ALGO_CONFIG_REDUCTION_SCHEME) == reduction &&
+        config_attr<int32_t>(a, CUBLASLT_ALGO_CONFIG_CUSTOM_OPTION) == custom) {
+      store_algo(a, algo);
+      return static_cast<int64_t>(res[i].workspaceSize);
+    }
+  }
+  return -1;
+}
+
+inline int64_t hopper_lt_check_config(int64_t M, int64_t N, int64_t K, bool out_f32, bool tf32,
+    TensorView cfg, int64_t max_workspace, TensorView algo) {
+  using namespace hopper_lt;
+  CHECK_HOST(M > 0 && N > 0 && K > 0 && max_workspace >= 0) << "hopper_lt_check_config args";
+  CHECK_HOST(cfg.device().device_type == kDLCPU && cfg.numel() == 9 && cfg.dtype().bits == 64)
+      << "cfg must be a 9-element int64 CPU tensor";
+  const int64_t* c = static_cast<const int64_t*>(cfg.data_ptr());
+  Desc d(M, N, K, out_f32, tf32);
+  const cudaDataType_t dt = out_f32 ? CUDA_R_32F : CUDA_R_16BF;
+  cublasLtMatmulAlgo_t a{};
+  if (cublasLtMatmulAlgoInit(handle(), compute_type(tf32), CUDA_R_32F, in_type(tf32), in_type(tf32), dt, dt,
+      static_cast<int>(c[0]), &a) != CUBLAS_STATUS_SUCCESS) {
+    return -1;
+  }
+  for (int i = 1; i < 9; ++i) {
+    cublasStatus_t s;
+    const auto attr = static_cast<cublasLtMatmulAlgoConfigAttributes_t>(i);
+    if (i >= 7) {
+      const uint16_t v = static_cast<uint16_t>(c[i]);
+      s = cublasLtMatmulAlgoConfigSetAttribute(&a, attr, &v, sizeof(v));
+    } else {
+      const uint32_t v = static_cast<uint32_t>(c[i]);
+      s = cublasLtMatmulAlgoConfigSetAttribute(&a, attr, &v, sizeof(v));
+    }
+    if (s != CUBLAS_STATUS_SUCCESS && c[i] != 0) return -1;
+  }
+  cublasLtMatmulHeuristicResult_t r{};
+  if (cublasLtMatmulAlgoCheck(handle(), d.op, d.la, d.lb, d.lc, d.lc, &a, &r) != CUBLAS_STATUS_SUCCESS) return -1;
+  if (r.state != CUBLAS_STATUS_SUCCESS || r.workspaceSize > static_cast<size_t>(max_workspace)) return -1;
+  store_algo(a, algo);
+  return static_cast<int64_t>(r.workspaceSize);
+}
+
+inline void hopper_lt_gemm(TensorView x, TensorView w, TensorView out, TensorView workspace, TensorView algo) {
+  using namespace host;
+  using namespace hopper_lt;
+  auto M = SymbolicSize{"M"};
+  auto N = SymbolicSize{"N"};
+  auto K = SymbolicSize{"K"};
+  auto device = SymbolicDevice{};
+  device.set_options<kDLCUDA>();
+  TensorMatcher({M, K}).with_dtype<bf16_t, fp32_t>().with_device<kDLCUDA>(device).ensure_alignment(16).verify(x);
+  TensorMatcher({N, K}).with_dtype<bf16_t, fp32_t>().with_device<kDLCUDA>(device).ensure_alignment(16).verify(w);
+  TensorMatcher({M, N}).with_dtype<bf16_t, fp32_t>().with_device<kDLCUDA>(device).ensure_alignment(16).verify(out);
+  CHECK_HOST(algo.device().device_type == kDLCPU && algo.numel() == 64) << "algo must be a 64-byte CPU tensor";
+  const bool tf32 = x.dtype().bits == 32, out_f32 = out.dtype().bits == 32;
+  CHECK_HOST(w.dtype().bits == x.dtype().bits && (out_f32 || !tf32)) << "hopper_lt_gemm dtypes";
+  const int64_t m = M.unwrap(), n = N.unwrap(), k = K.unwrap();
+  if (m == 0) return;
+  cublasLtMatmulAlgo_t a;
+  memcpy(&a, algo.data_ptr(), sizeof(a));
+  Desc d(m, n, k, out_f32, tf32);
+  const float alpha = 1.f, beta = 0.f;
+  const auto stream = LaunchKernel::resolve_device(device.unwrap());
+  const size_t ws_bytes = static_cast<size_t>(workspace.numel());
+  const cublasStatus_t s = cublasLtMatmul(handle(), d.op, &alpha, w.data_ptr(), d.la, x.data_ptr(), d.lb, &beta,
+      out.data_ptr(), d.lc, out.data_ptr(), d.lc, &a, ws_bytes ? workspace.data_ptr() : nullptr, ws_bytes, stream);
+  CHECK_HOST(s == CUBLAS_STATUS_SUCCESS) << "cublasLtMatmul failed: " << static_cast<int>(s);
+}
+
+}

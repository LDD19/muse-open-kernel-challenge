+SGL_DEVICE float gath_ss8(const uint4& v) {
+  const __nv_bfloat162* h = reinterpret_cast<const __nv_bfloat162*>(&v);
+  float s = 0.f;
+  for (int i = 0; i < 4; ++i) {
+    const float2 f = __bfloat1622float2(h[i]);
+    s += f.x * f.x + f.y * f.y;
+  }
+  return s;
+}
+SGL_DEVICE float gath_rr(float tot) { return rsqrtf(tot * (1.f / HD) + PRE_NORM_EPS); }
+SGL_DEVICE void gath_g1p(const Params& p, int t, float* g1p) {

+  ss = __fadd_rn(ss, __shfl_xor_sync(0xffffffffu, ss, 4));
+  ss = __fadd_rn(ss, __shfl_xor_sync(0xffffffffu, ss, 2));
+  ss = __fadd_rn(ss, __shfl_xor_sync(0xffffffffu, ss, 1));
+  const float r = rsqrtf(__fadd_rn(ss / 64.f, 1e-5f));
+  for (int i = 0; i < 8; ++i) x[i] = __fmul_rn(x[i], r);
+  if constexpr (ROPE) {
+    for (int i = 0; i < 8; ++i) x[i] = qk_bf16r(x[i]);
+    for (int j = 0; j < 4; ++j) {
+      const float c = cs[d0 / 2 + j], s = sn[d0 / 2 + j];
+      const float e = x[2 * j], o = x[2 * j + 1];
+      x[2 * j] = __fmaf_rn(e, c, -__fmul_rn(o, s));
+      x[2 * j + 1] = __fmaf_rn(o, c, __fmul_rn(e, s));
+    }
+  }
+}
+template <bool ROPE>
+__global__ void __launch_bounds__(128) qk_prep_kernel(const __nv_bfloat16* __restrict__ qkv, const long long* __restrict__ pos,
+    const long long* __restrict__ loc, const float* __restrict__ invf,
+    uint8_t* __restrict__ q8, uint8_t* __restrict__ kc, uint8_t* __restrict__ vc) {

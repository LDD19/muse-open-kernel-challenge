+#define BND_MINB 3
+template <bool GPOST, int MODE>
+__global__ void __launch_bounds__(BND_TPB, MODE == 2 ? BND_RC_MINB : BND_MINB) boundary_kernel(const __nv_bfloat16* __restrict__ branch, const float* __restrict__ stream,

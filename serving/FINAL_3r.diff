+  CHECK_HOST(ids.size(1) == 8 && lid.size(0) == T && cnt.numel() >= 32) << "hopper_moe_ids_to_routes shapes";
+  if (T == 0) return;
+  launch_pdl(moe_ids_route_kernel, dim3((T + ROUTE_WARPS - 1) / ROUTE_WARPS), dim3(ROUTE_WARPS * 32), 0,
+      stream_of(ids), ptr<const int>(ids), ptr<const int>(lstart), ptr<int>(lid), ptr<int>(pos), ptr<int>(cnt), T,
+      ptr<const int>(ntok), static_cast<int>(num_experts));
+}

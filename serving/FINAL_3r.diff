+inline void hopper_moe_route(TensorView logits, TensorView bias, TensorView lstart, TensorView ids, TensorView w,
+    TensorView lid, TensorView pos, TensorView cnt, TensorView ntok) {
+  using namespace muse_hopper_moe;
+  const int T = static_cast<int>(logits.size(0));
+  const int64_t E = logits.size(1) / 2;
+  CHECK_HOST(ids.size(0) == T && cnt.numel() >= 32) << "hopper_moe_route shapes";
+  CHECK_HOST(E == 32 || E == 64 || E == 128 || E == 256) << "hopper_moe_route: " << E << " experts";
+  if (T == 0) return;
+  auto* k = E == 256 ? moe_route_kernel<8>
+      : (E == 128 ? moe_route_kernel<4> : (E == 64 ? moe_route_kernel<2> : moe_route_kernel<1>));
+  launch_pdl(k, dim3((T + ROUTE_WARPS - 1) / ROUTE_WARPS), dim3(ROUTE_WARPS * 32), 0,
+      stream_of(logits), ptr<const float>(logits), ptr<const float>(bias), ptr<const int>(lstart), ptr<int>(ids),
+      ptr<float>(w), ptr<int>(lid), ptr<int>(pos), ptr<int>(cnt), T, ptr<const int>(ntok));
+}

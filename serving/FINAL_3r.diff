+"""
+LDD19: idea from ZhimaoL/sglang okc/cand14, Apache-2.0.
+"""
+from __future__ import annotations
+import logging
+import sys
+import time
+from typing import Optional
+import torch
+logger=logging.getLogger(__name__)
+def _power_of_two_classes(max_bs:int)->list[int]:
+  classes,bs=[],1
+  while True:
+    classes.append(bs)
+    if bs>=max_bs:
+      return classes
+    bs*=2
+def warm_batch_size_variants(scheduler,max_running_requests:Optional[int])->None:
+  m=sys.modules.get( "sglang.srt.layers.muse_spark.muse_spark_hopper_prefill")
+  if m and torch.distributed.is_initialized()and torch.distributed.get_rank()==0 :
+    a=getattr(m, "_ARM",{})
+    logger.info( "[muse-comm] form A %s; %s",getattr(m, "_ARMED",[ "?"])[0 ],
+                " ".join( "%s=%d"%(k,a.get(k,0 ))for k in( "o2ce", "ipc_qkv", "owce", "tapfc")))
+  try:
+    pool=getattr(scheduler, "req_to_token_pool",None)
+    req_to_token=getattr(pool, "req_to_token",None)
+    if not isinstance(req_to_token,torch.Tensor)or not req_to_token.is_cuda:
+      return
+    from sglang.srt.mem_cache.allocation import assign_req_to_token_pool_func
+    max_bs=max(1 ,int(max_running_requests or 32 ))
+    device=req_to_token.device
+    start=time.perf_counter()
+    dummy_rows=torch.zeros((1 ,req_to_token.shape[1 ]),dtype=req_to_token.dtype,device=device)
+    slots=torch.zeros((2 ,),dtype=torch.int64,device=device)
+    launches=0
+    for bs in _power_of_two_classes(max_bs):
+      req_indices=torch.zeros((bs,),dtype=torch.int64,device=device)
+      lengths=torch.zeros((bs,),dtype=torch.int32,device=device)
+      for out_cache_loc in(slots[:1 ],slots[1 :]):
+        assign_req_to_token_pool_func(req_indices,dummy_rows,lengths,lengths,out_cache_loc,bs)
+        launches+=1
+    torch.cuda.synchronize(device)
+    logger.info(
+        "Boot warm-up: %d assign_req_to_token_pool variants (batch classes up "
+        "to %d) in %.2f s.",
+        launches,
+        max_bs,
+        time.perf_counter()-start,
+    )
+  except Exception as e:
+    logger.warning( "Boot warm-up skipped: %r",e)

+#define MOE_GATHER_MINB 1
+#define MOE_GATHER_MINB6_MIN_TOKENS 1024
+#define MOE_GATHER_MINB8_MIN_TOKENS 8192
+#define MOE_PADFILL_PARTS 8
+template <int MINB>
+__global__ void __launch_bounds__(256, MINB) moe_gather_kernel(const __nv_bfloat16* __restrict__ p,
+    const __nv_bfloat16* __restrict__ gw, const int* __restrict__ lid,
+    const int* __restrict__ pos, const int* __restrict__ counts, uint8_t* __restrict__ xt,
+    int* __restrict__ rrow, int T, int* __restrict__ offsets_out,
+    int4* __restrict__ tiles, int* __restrict__ ntiles, int* __restrict__ rows_out, int order,
+    long long* __restrict__ rdst = nullptr, const long long* __restrict__ ib = nullptr, const int* __restrict__ tmap = nullptr,
+    int m = 1) {
+  pdl_enter();
+  const int tok = blockIdx.x;
+  const int tid = threadIdx.x;
+  const int fine = order >> 8;
+  __shared__ float red[8];
+  __shared__ int off_s[32];
+  if (tid < 32) {
+    int full, r, nr, nb;
+    expert_tiles(counts[tid], fine, full, r, nr, nb);
+    const int rows = full * 256 + nr + nb;
+    off_s[tid] = warp_incl_sum(rows, tid) - rows;
+    if (blockIdx.x == 0) plan_warp(counts, offsets_out, tiles, ntiles, rows_out, order, tid);
+  }
+  const int* offsets = off_s;
+  if (tok >= T) {
+    __syncthreads();
+    const int idx = tok - T, e = idx / MOE_PADFILL_PARTS, part = idx % MOE_PADFILL_PARTS;
+    int full, r, nr, nb;
+    expert_tiles(counts[e], fine, full, r, nr, nb);
+    for (int q = 0; q < 2; ++q) {
+      const int n = q ? nb : nr;
+      if (n == 0) continue;
+      const int r0 = offsets[e] + 256 * full + (q ? nr : 0);
+      const int used = q ? r - nr : (r < nr ? r : nr);
+      for (int lr = used + part; lr < n; lr += MOE_PADFILL_PARTS) {
+        if (rdst && tid == 0) rdst[r0 + lr] = ib[8];
+        for (int i = tid; i < 64 * 8; i += 256) {
+          const int stg = i >> 3, ch = i & 7;
+          *reinterpret_cast<uint4*>(xt + (size_t)r0 * 8192 + (size_t)stg * n * 128 + lr * 128 + ch * 16) =
+              make_uint4(0, 0, 0, 0);
+        }
+      }
+    }
+    return;
+  }
+  bool any = false;
+  for (int k = 0; k < 8; ++k) any |= lid[tok * 8 + k] >= 0;
+  if (!any) {
+    if (tid < 8) rrow[tok * 8 + tid] = -1;
+    return;
+  }
+  const uint4* src = reinterpret_cast<const uint4*>(p + (size_t)tok * 4096 + tid * 16);
+  uint4 v0 = src[0], v1 = src[1];
+  __shared__ long long mrow[8];
+  __shared__ int mn[8], mlr[8];
+  __syncwarp();
+  if (tid < 8) {
+    const int k = tid;
+    const int l = lid[tok * 8 + k];
+    if (l < 0) {
+      rrow[tok * 8 + k] = -1;
+      mn[k] = 0;
+    } else {
+      const int ps = pos[tok * 8 + k];
+      int full, r, nr, nb;
+      expert_tiles(counts[l], fine, full, r, nr, nb);
+      const int tl = ps >> 8;
+      int row0 = offsets[l] + 256 * min(tl, full), lr = ps - 256 * min(tl, full), n = tl < full ? 256 : nr;
+      if (tl >= full && nb && lr >= nr) {
+        row0 += nr;
+        lr -= nr;
+        n = nb;
+      }
+      rrow[tok * 8 + k] = row0 + lr;
+      if (rdst) {
+        const int g = tmap ? tmap[tok] : tok, o = g / m;
+        rdst[row0 + lr] = ib[o] + ((long long)(g - o * m) * 8 + k) * 8192;
+      }
+      mrow[k] = (long long)row0 * 8192 + lr * 128;
+      mn[k] = n;
+      mlr[k] = lr;
+    }
+  }
+  float f[16];
+  const __nv_bfloat162* h0 = reinterpret_cast<const __nv_bfloat162*>(&v0);
+  const __nv_bfloat162* h1 = reinterpret_cast<const __nv_bfloat162*>(&v1);
+  for (int i = 0; i < 4; ++i) {
+    float2 a = __bfloat1622float2(h0[i]), b = __bfloat1622float2(h1[i]);
+    f[2 * i] = a.x; f[2 * i + 1] = a.y; f[8 + 2 * i] = b.x; f[8 + 2 * i + 1] = b.y;
+  }
+  float ss = 0.f;
+  for (int i = 0; i < 16; ++i) ss += f[i] * f[i];
+  const float tot = block_total<8, false>(ss, red, tid);
+  const float rr = rsqrtf(tot / 4096.f + 1e-5f);
+  uint32_t outw[8];
+  for (int i = 0; i < 4; ++i) {
+    const float4 gg = g1p4(gw + tid * 16 + 4 * i);
+    __nv_bfloat162 a = __floats2bfloat162_rn(f[4 * i] * rr * gg.x, f[4 * i + 1] * rr * gg.y);
+    __nv_bfloat162 b = __floats2bfloat162_rn(f[4 * i + 2] * rr * gg.z, f[4 * i + 3] * rr * gg.w);
+    outw[2 * i] = bf162_u32(a);
+    outw[2 * i + 1] = bf162_u32(b);
+  }
+  const int stg = tid >> 2, ch0 = 2 * (tid & 3);
+#pragma unroll
+  for (int k = 0; k < 8; ++k) {
+    const int n = mn[k];
+    if (n == 0) continue;
+    const int lr = mlr[k];
+    uint8_t* rowp = xt + mrow[k] + (size_t)stg * n * 128;
+    const int x = lr & 7;
+    *reinterpret_cast<uint4*>(rowp + ((ch0 ^ x) << 4)) = make_uint4(outw[0], outw[1], outw[2], outw[3]);
+    *reinterpret_cast<uint4*>(rowp + (((ch0 + 1) ^ x) << 4)) = make_uint4(outw[4], outw[5], outw[6], outw[7]);
+  }
+}

+DEVI float qk_bf16r(float x) { return __bfloat162float(__float2bfloat16_rn(x)); }
+DEVI uint2 qk_pack8(const float (&x)[8]) {
+  float r[8];
+  for (int i = 0; i < 8; ++i) r[i] = qk_bf16r(x[i]);
+  return make_uint2(qk_e4m3x2(r[0], r[1]) | (qk_e4m3x2(r[2], r[3]) << 16), qk_e4m3x2(r[4], r[5]) | (qk_e4m3x2(r[6], r[7]) << 16));

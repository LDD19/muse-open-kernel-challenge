+SGL_DEVICE void gath_norm8(uint4& v, float rr, const float* g1p) {
+  __nv_bfloat162* h = reinterpret_cast<__nv_bfloat162*>(&v);
+  for (int i = 0; i < 4; ++i) {
+    const float2 f = __bfloat1622float2(h[i]);
+    h[i] = __floats2bfloat162_rn(f.x * rr * g1p[2 * i], f.y * rr * g1p[2 * i + 1]);
+  }
+}
+__device__ void wgs_gather(const Params& p, Smem& S, int c) {
+  const int tid = threadIdx.x, nj = S.njF + S.njS;
+  const int R = S.jrow[nj];

+inline void hopper_boundary(TensorView branch, TensorView stream, TensorView gpost, TensorView alpha, TensorView beta,
+    TensorView gpre, TensorView sout, TensorView nout, bool has_gpost, TensorView zero) {
+  using namespace muse_hopper_moe;
+  const int T = static_cast<int>(stream.size(0));
+  CHECK_HOST(stream.size(1) == 8192 && branch.size(0) == T) << "hopper_boundary shapes";
+  if (T == 0) return;
+  auto* k = has_gpost ? boundary_kernel<true, 0> : boundary_kernel<false, 0>;
+  launch_pdl(k, dim3(T), dim3(BND_TPB), 0, stream_of(stream), ptr<const __nv_bfloat16>(branch),
+      ptr<const float>(stream), ptr<const __nv_bfloat16>(gpost), ptr<const float>(alpha), ptr<const float>(beta),
+      ptr<const __nv_bfloat16>(gpre), ptr<float>(sout), ptr<__nv_bfloat16>(nout),
+      zero.numel() ? ptr<int>(zero) : static_cast<int*>(nullptr), static_cast<int>(zero.numel()),
+      static_cast<const __nv_bfloat16*>(nullptr), static_cast<float*>(nullptr), static_cast<const float*>(nullptr),
+      static_cast<const float*>(nullptr));
+}

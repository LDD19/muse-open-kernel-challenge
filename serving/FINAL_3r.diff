+DEVI void route_publish(int* s_cnt, int* s_base, int* cnt) {
+  __syncthreads();
+  if (threadIdx.x < 32) {
+    const int c = s_cnt[threadIdx.x];
+    s_base[threadIdx.x] = c ? atomicAdd(cnt + threadIdx.x, c) : 0;
+  }
+  __syncthreads();
+}
+#define ROUTE_WARPS 16
+template <int J>
+__global__ void __launch_bounds__(ROUTE_WARPS * 32) moe_route_kernel(const float* __restrict__ logits,
+    const float* __restrict__ bias, const int* __restrict__ lstart, int* __restrict__ ids, float* __restrict__ wout,
+    int* __restrict__ lid, int* __restrict__ pos, int* __restrict__ cnt, int T, const int* __restrict__ ntok) {
+  pdl_enter();
+  __shared__ int s_cnt[32], s_base[32];
+  const int t = blockIdx.x * ROUTE_WARPS + (threadIdx.x >> 5), lane = threadIdx.x & 31;
+  if (threadIdx.x < 32) s_cnt[threadIdx.x] = 0;
+  __syncthreads();
+  int e_mine = 0, loc = 0, lpos = 0;
+  bool local = false;
+  float w_mine = 0.f;
+  if (t < *ntok) {
+    const float* lg = logits + (size_t)t * (64 * J);
+    float sv[J], bv[J];
+    for (int j = 0; j < J; ++j) {
+      const int e = lane + 32 * j;
+      const float x = (lg[e] + lg[32 * J + e]) * 0.1767766952966369f;
+      sv[j] = route_div_full(1.0f, route_ex2((0.0f - x) * 1.4426950408889634f) + 1.0f);
+      bv[j] = sv[j] + bias[e];
+    }
+    int sel_e[8];
+    float sel_s[8];
+    for (int k = 0; k < 8; ++k) {
+      float bvv = bv[0];
+      int be = lane;
+      for (int j = 1; j < J; ++j) {
+        if (bv[j] > bvv) { bvv = bv[j]; be = lane + 32 * j; }
+      }
+      {
+        const uint32_t u = __float_as_uint(bvv);
+        const uint32_t key = (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+        const uint32_t mk = __reduce_max_sync(0xffffffffu, key);
+        be = (int)__reduce_min_sync(0xffffffffu, key == mk ? (uint32_t)be : 0xffffffffu);
+      }
+      float mys = 0.f;
+#pragma unroll
+      for (int j = 0; j < J; ++j) {
+        if (j == (be >> 5)) mys = sv[j];
+      }
+      sel_s[k] = __shfl_sync(0xffffffffu, mys, be & 31);
+      sel_e[k] = be;
+      for (int j = 0; j < J; ++j) {
+        if (lane + 32 * j == be) bv[j] = -INFINITY;
+      }
+    }
+    float sum = 0.f;
+    for (int k = 0; k < 8; ++k) sum += sel_s[k];
+    e_mine = sel_e[0];
+    float sk = sel_s[0];
+#pragma unroll
+    for (int k = 1; k < 8; ++k) {
+      if (lane == k) { e_mine = sel_e[k]; sk = sel_s[k]; }
+    }
+    w_mine = sk * route_div_full(1.0f, sum + 1e-15f);
+    loc = (e_mine - *lstart + 32 * J) % (32 * J);
+    local = lane < 8 && loc < 32;
+    if (local) lpos = atomicAdd(&s_cnt[loc], 1);
+  }
+  route_publish(s_cnt, s_base, cnt);
+  if (t < T && lane < 8) {
+    ids[t * 8 + lane] = e_mine;
+    wout[t * 8 + lane] = w_mine;
+    lid[t * 8 + lane] = local ? loc : -1;
+    pos[t * 8 + lane] = local ? s_base[loc] + lpos : 0;
+  }
+}

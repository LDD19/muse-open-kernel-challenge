+template <bool ROPE>
+DEVI void qk_norm_rope8(float (&x)[8], const float* cs, const float* sn, int d0) {
+  float p[4];
+  for (int i = 0; i < 4; ++i) p[i] = __fmaf_rn(x[2 * i], x[2 * i], __fmul_rn(x[2 * i + 1], x[2 * i + 1]));

+SGL_DEVICE int gath_job(const Smem& S, int nj, int q) {
+  int lo = 0, hi = nj;
+  while (hi - lo > 1) { const int mid = (lo + hi) >> 1; if (S.jrow[mid] <= q) lo = mid; else hi = mid; }
+  return lo;

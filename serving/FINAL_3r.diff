+from __future__ import annotations
+from typing import TYPE_CHECKING,Dict,Optional
+import torch
+from sglang.kernels.jit.utils import cache_once,load_jit
+if TYPE_CHECKING:
+  from tvm_ffi.module import Module
+D_EXPERT = 4096
+TOP_K=8
+ENGINE_MAX_TOKENS=384
+SMALL_JOB_MAX_TOKENS=32
+MAX_JOBS=32 +ENGINE_MAX_TOKENS*TOP_K//32 +8
+FLAG_INTS=32 +160 +MAX_JOBS*16 +4
+FIX_SLOTS=160
+FIX_FLOATS=2 *FIX_SLOTS*4 *8 *512
+FIX_COUNTS=2 *FIX_SLOTS*4
+@cache_once
+def hopper_moe_engine_module(job_tokens:int)->Module:
+  return load_jit(
+      "muse_spark_hopper_moe_engine", f"ft{job_tokens}", cuda_files=["muse_spark/hopper_moe_engine.cuh"],
+      cuda_wrappers=[( "engine", "hopper_moe_engine"),( "zero_flags", "hopper_moe_engine_zero_flags")],
+      extra_cuda_cflags=["--use_fast_math", f"-DMOE_ENGINE_FT_T={job_tokens}"],
+  )
+def engine_xrows(num_tokens:int,job_tokens:int)->int:
+  return 8 *num_tokens+8 *(32 +8 *num_tokens//job_tokens+8 )
+class _StreamKBuffers:
+  _by_device:Dict[int, "_StreamKBuffers"]={}
+  def __init__(self,device:torch.device):
+    self.fix=torch.zeros(FIX_FLOATS,dtype=torch.float32,device=device)
+    self.counts=torch.zeros(FIX_COUNTS,dtype=torch.int32,device=device)
+  @classmethod
+  def get(cls,device:torch.device)-> "_StreamKBuffers":
+    index=device.index if device.index is not None else torch.cuda.current_device()
+    if index not in cls._by_device:
+      cls._by_device[index]=cls(torch.device( "cuda",index))
+    return cls._by_device[index]
+class MuseSparkHopperMoEEngine:
+  def __init__(self,w13:torch.Tensor,w2:torch.Tensor,gs13:torch.Tensor,gs2:torch.Tensor):
+    self.w13,self.w2,self.gs13,self.gs2=w13,w2,gs13,gs2
+    dev=w13.device
+    self.num_sms=torch.cuda.get_device_properties(dev).multi_processor_count
+    self.buffers=_StreamKBuffers.get(dev)
+    for job_tokens in(32 ,64 ):
+      hopper_moe_engine_module(job_tokens)
+  @staticmethod
+  def applies(num_tokens:int)->bool:
+    return 0 <num_tokens<=ENGINE_MAX_TOKENS
+  def __call__(
+      self,x:torch.Tensor,topk_weights:torch.Tensor,topk_ids:torch.Tensor,local_start:torch.Tensor,
+      pre_norm_w:torch.Tensor,post_norm_w:torch.Tensor,flags:Optional[torch.Tensor]=None,
+  )->torch.Tensor:
+    T=x.shape[0 ]
+    job_tokens=32 if T<=SMALL_JOB_MAX_TOKENS else 64
+    ids=topk_ids.to(torch.int32).contiguous()
+    if ids.data_ptr()%16 :
+      ids=ids.clone()
+    flags_zeroed=flags is not None
+    if not flags_zeroed:
+      flags=x.new_empty((FLAG_INTS,),dtype=torch.int32)
+    ybuf=x.new_empty((T*TOP_K,D_EXPERT),dtype=torch.float32)
+    xbuf=x.new_empty((2 ,engine_xrows(T,job_tokens),D_EXPERT),dtype=torch.bfloat16)
+    out=x.new_empty((T,D_EXPERT),dtype=torch.bfloat16)
+    hopper_moe_engine_module(job_tokens).engine(
+        x.contiguous(),ids,topk_weights.to(torch.float32).contiguous(),local_start,self.w13,self.w2,
+        self.gs13,self.gs2,pre_norm_w,post_norm_w,flags,ybuf,xbuf,self.buffers.fix,
+        self.buffers.counts,out,self.num_sms,int(flags_zeroed),
+    )
+    return out
+  def zeroed_flags_engine(self)->torch.Tensor:
+    flags=self.w13.new_empty((FLAG_INTS,),dtype=torch.int32)
+    hopper_moe_engine_module(SMALL_JOB_MAX_TOKENS).zero_flags(flags)
+    return flags

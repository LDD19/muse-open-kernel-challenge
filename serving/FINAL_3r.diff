+        k_cache,
+        v_cache,
+        cache_loc,
+        op._eps,
+        op._num_q_heads,
+        op._num_kv_heads,
+        torch.cuda.get_device_properties(qkv.device).multi_processor_count,
+    )
+    return q_out,k_out
+  pdl={ "USE_PDL":True, "launch_pdl":True}if is_arch_support_pdl()else{}
+  _qk_norm_rope_verify_store_kernel[(triton.cdiv(n_rows,block_m),)](
+      qkv,
+      q_out.view(torch.uint8),
+      k_out,
+      positions if has_rope else qkv,
+      cos_sin_cache if has_rope else qkv,
+      k_cache,
+      v_cache,
+      cache_loc,
+      op._eps,
+      qkv.stride(0 ),
+      n_rows,
+      op._num_q_heads,
+      op._num_kv_heads,
+      d,
+      triton.next_power_of_2(d),
+      block_m,
+      HAS_ROPE=has_rope,
+      SATURATE=flavour[0 ],
+      NAN_KEEPS_SIGN=flavour[1 ],
+      num_warps=num_warps,
+      **pdl,
+  )
+  return q_out,k_out

+from __future__ import annotations
+from typing import TYPE_CHECKING,Tuple
+import torch
+from sglang.kernels.jit.utils import cache_once,load_jit
+if TYPE_CHECKING:
+  from tvm_ffi.module import Module
+MAX_K=32
+@cache_once
+def _module()->Module:
+  return load_jit(
+      "dflash_shard_topk",cuda_files=[ "speculative/dflash_shard_topk.cuh"],
+      cuda_wrappers=[( "shard_topk", "dflash_shard_topk")],extra_cuda_cflags=[ "-O3"],
+  )
+def shard_topk_supported(logits:torch.Tensor,k:int)->bool:
+  return(
+      logits.is_cuda
+      and torch.version.hip is None
+      and logits.dim()==2
+      and logits.dtype in(torch.bfloat16,torch.float32)
+      and logits.stride(-1 )==1
+      and 1 <=k<=min(MAX_K,logits.shape[-1 ])
+  )
+def shard_topk(logits:torch.Tensor,k:int,vocab_start:int)->Tuple[torch.Tensor,torch.Tensor]:
+  rows=logits.shape[0 ]
+  vals=torch.empty((rows,k),dtype=torch.float32,device=logits.device)
+  ids=torch.empty((rows,k),dtype=torch.int64,device=logits.device)
+  _module().shard_topk(logits,vals,ids,int(vocab_start))
+  return vals,ids

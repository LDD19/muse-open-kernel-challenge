index 0000000000..35ba062498
--- /dev/null
+++ b/python/sglang/kernels/ops/gemm/hopper_bf16_lt_gemm.py
@@ -0,0 +1,98 @@
+from __future__ import annotations
+from typing import TYPE_CHECKING,Dict,NamedTuple,Optional,Sequence,Tuple,Union
+import torch
+from sglang.kernels.jit.utils import cache_once,load_jit
+if TYPE_CHECKING:
+  from tvm_ffi.module import Module
+MAX_HEURISTIC_ALGOS=32
+MAX_WORKSPACE_BYTES=64 <<20
+OPERAND_ALIGNMENT=256
+class LtSignature(NamedTuple):
+  tile:int
+  splitk:int
+  reduction:int
+  custom:int
+class LtConfig(NamedTuple):
+  algo_id:int
+  tile:int
+  splitk:int
+  reduction:int
+  swizzle:int
+  custom:int
+  stages:int
+  inner_shape:int
+  cluster_shape:int
+class LtRule(NamedTuple):
+  lo:int
+  hi:int
+  candidates:Tuple[Union[LtSignature,LtConfig],...]
+@cache_once
+def hopper_lt_gemm_module()->Module:
+  return load_jit(
+      "hopper_bf16_lt_gemm",cuda_files=[ "gemm/hopper_bf16_lt_gemm.cuh"],
+      cuda_wrappers=[
+          ( "find_algo", "hopper_lt_find_algo"),( "check_config", "hopper_lt_check_config"),
+          ( "gemm", "hopper_lt_gemm"),
+      ],
+      extra_ldflags=[ "-lcublasLt"],
+  )
+class _Plan(NamedTuple):
+  algo:torch.Tensor
+  workspace_bytes:int
+class LtGemm:
+  def __init__(
+      self,rules:Sequence[LtRule],out_dtype:torch.dtype=torch.bfloat16,in_dtype:torch.dtype=torch.bfloat16,
+      max_workspace:int=MAX_WORKSPACE_BYTES,
+  ):
+    self.rules=tuple(rules)
+    self.out_dtype=out_dtype
+    self.in_dtype=in_dtype
+    self.max_workspace=max_workspace
+    self._plans:Dict[Tuple[int,int,int],Optional[_Plan]]={}
+  def _resolve(self,m:int,n:int,k:int)->Optional[_Plan]:
+    rule=next((r for r in self.rules if r.lo<=m<r.hi),None)
+    if rule is None:
+      return None
+    mod=hopper_lt_gemm_module()
+    out_f32=self.out_dtype==torch.float32
+    tf32=self.in_dtype==torch.float32
+    for cand in rule.candidates:
+      algo=torch.empty(64 ,dtype=torch.uint8)
+      if isinstance(cand,LtConfig):
+        cfg=torch.tensor(list(cand),dtype=torch.int64)
+        ws=mod.check_config(m,n,k,out_f32,tf32,cfg,self.max_workspace,algo)
+      else:
+        ws=mod.find_algo(
+            m,n,k,out_f32,tf32,cand.tile,cand.splitk,cand.reduction,cand.custom,
+            self.max_workspace,MAX_HEURISTIC_ALGOS,algo,
+        )
+      if ws>=0 :
+        return _Plan(algo,int(ws))
+    return None
+  def plan(self,m:int,n:int,k:int)->Optional[_Plan]:
+    key=(m,n,k)
+    if key not in self._plans:
+      self._plans[key]=self._resolve(m,n,k)
+    return self._plans[key]
+  def applies(self,x:torch.Tensor,w:torch.Tensor)->bool:
+    return(
+        x.ndim==2
+        and w.ndim==2
+        and x.dtype==self.in_dtype
+        and w.dtype==self.in_dtype
+        and(self.in_dtype==torch.bfloat16 or x.is_cuda)
+        and x.is_contiguous()
+        and w.is_contiguous()
+        and x.shape[0 ]>0
+        and x.shape[1 ]==w.shape[1 ]
+        and x.data_ptr()%OPERAND_ALIGNMENT==0
+        and w.data_ptr()%OPERAND_ALIGNMENT==0
+        and(self.in_dtype==torch.bfloat16 or torch.backends.cuda.matmul.allow_tf32)
+        and self.plan(x.shape[0 ],w.shape[0 ],w.shape[1 ])is not None
+    )
+  def __call__(self,x:torch.Tensor,w:torch.Tensor)->torch.Tensor:
+    plan=self.plan(x.shape[0 ],w.shape[0 ],w.shape[1 ])
+    out=x.new_empty((x.shape[0 ],w.shape[0 ]),dtype=self.out_dtype)
+    ws=x.new_empty((plan.workspace_bytes,),dtype=torch.uint8)
+    hopper_lt_gemm_module().gemm(x,w,out,ws,plan.algo)
+    return out

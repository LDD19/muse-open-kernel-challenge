+inline void moe_gather_impl(TensorView p, TensorView gw, TensorView lid, TensorView pos, TensorView counts,
+    TensorView xt, TensorView rrow, TensorView offsets, TensorView tiles, TensorView ntiles, TensorView rows,
+    int64_t order, long long* rd, const long long* ib, const int* tm, int m) {
+  using namespace muse_hopper_moe;
+  const int T = static_cast<int>(p.size(0));
+  CHECK_HOST(p.size(1) == 4096 && p.stride(0) == 4096) << "hopper_moe_gather_plan: p must be [T, 4096] contiguous";
+  auto* gk = T >= MOE_GATHER_MINB8_MIN_TOKENS ? moe_gather_kernel<8>
+      : (T >= MOE_GATHER_MINB6_MIN_TOKENS ? moe_gather_kernel<6> : moe_gather_kernel<MOE_GATHER_MINB>);
+  launch_pdl(gk, dim3(T + 32 * MOE_PADFILL_PARTS), dim3(256), 0, stream_of(p), ptr<const __nv_bfloat16>(p),
+      ptr<const __nv_bfloat16>(gw), ptr<const int>(lid), ptr<const int>(pos), ptr<const int>(counts),
+      ptr<uint8_t>(xt), ptr<int>(rrow), T, ptr<int>(offsets), ptr<int4>(tiles), ptr<int>(ntiles), ptr<int>(rows),
+      static_cast<int>(order), rd, ib, tm, m);
+}
+inline void hopper_moe_gather_plan(TensorView p, TensorView gw, TensorView lid, TensorView pos, TensorView counts,
+    TensorView xt, TensorView rrow, TensorView offsets, TensorView tiles, TensorView ntiles, TensorView rows,
+    int64_t order) {

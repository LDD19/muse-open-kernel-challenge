+namespace sglang {
+using tvm::ffi::TensorView;
+namespace dflash_detail {
+#define DFLASH_SKINNY_GEMM_CONFIGS(X) \
+  X(1, 1, 256, 6) \
+  X(2, 1, 256, 4) \
+  X(4, 1, 256, 3) \
+  X(1, 2, 256, 6) \
+  X(2, 2, 256, 4) \
+  X(4, 2, 256, 2)
+
+inline dflash_skinny_gemm::Params gemm_params(const TensorView& x, const TensorView& w, const TensorView& y) {
+  dflash_skinny_gemm::Params params = {};
+  params.x = static_cast<const bf16_t*>(x.data_ptr());
+  params.w = static_cast<const bf16_t*>(w.data_ptr());
+  params.y = static_cast<bf16_t*>(y.data_ptr());
+  params.m = static_cast<int>(x.size(0));
+  params.n = static_cast<int>(w.size(0));
+  params.k = static_cast<int>(x.size(1));
+  params.ldx = x.stride(0);
+  params.ldw = w.stride(0);
+  params.ldy = y.stride(0);
+  return params;
+}
+
+template <bool kConv>
+inline void launch_config(const dflash_skinny_gemm::Params& params, const TensorView& x, int64_t warps,
+    int64_t token_frags, int64_t block_k, int64_t stages, int64_t splits, bool programmatic) {
+  using namespace host;
+  const DLDevice dev = x.device();
+  const auto stream = LaunchKernel::resolve_device(dev);
+  cudaError_t status = cudaErrorInvalidConfiguration;
+  if (!kConv && warps == 4 && token_frags == 4 && block_k == 128 && stages == 8) {
+    status = dflash_skinny_gemm::launch<4, 4, 128, 8, true>(params, static_cast<int>(splits), stream, programmatic);
+  } else
+#define DFLASH_SKINNY_GEMM_DISPATCH(W, F, BK, S) \
+  if (warps == W && token_frags == F && block_k == BK && stages == S) { \
+    status = dflash_skinny_gemm::launch<W, F, BK, S, false, kConv>(params, static_cast<int>(splits), stream, \
+        programmatic); \
+  } else
+  DFLASH_SKINNY_GEMM_CONFIGS(DFLASH_SKINNY_GEMM_DISPATCH) {
+    RuntimeCheck(false, "dflash_skinny_gemm: configuration not instantiated");
+  }
+#undef DFLASH_SKINNY_GEMM_DISPATCH
+  RuntimeCheck(status == cudaSuccess, "dflash_skinny_gemm: launch failed: ", cudaGetErrorString(status));
+}
+
+}
+
+inline void dflash_skinny_gemm(TensorView x, TensorView w, TensorView y,
+    int64_t warps, int64_t token_frags, int64_t block_k, int64_t stages, int64_t splits, bool programmatic) {
+  const auto params = dflash_detail::gemm_params(x, w, y);
+  dflash_detail::launch_config<false>(params, x, warps, token_frags, block_k, stages, splits, programmatic);
+}
+
+inline void dflash_skinny_gemm_conv_prepare(TensorView x, TensorView w, TensorView y, TensorView base,
+    TensorView conv_out, int64_t block_size, int64_t warps, int64_t token_frags, int64_t block_k, int64_t stages,
+    int64_t splits, bool programmatic) {
+  auto params = dflash_detail::gemm_params(x, w, y);
+  const int64_t taps = base.size(0), k = x.size(1), groups = w.size(0) / (2 * taps);
+  const int64_t groups_per_tile = 16 * warps / taps, group_size = k / groups;
+  params.conv_base = static_cast<const bf16_t*>(base.data_ptr());
+  params.conv_out = static_cast<bf16_t*>(conv_out.data_ptr());
+  params.ld_base = base.stride(0);
+  params.ld_conv = conv_out.stride(0);
+  params.taps = static_cast<int>(taps);
+  params.groups = static_cast<int>(groups);
+  params.group_size = static_cast<int>(group_size);
+  params.block_size = static_cast<int>(block_size);
+  params.conv_window = static_cast<int>(groups_per_tile * group_size);
+  dflash_detail::launch_config<true>(params, x, warps, token_frags, block_k, stages, splits, programmatic);
+}
+
+}
